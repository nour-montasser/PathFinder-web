{% extends 'base.html.twig' %}

{% block title %}My Profile - PathFinder{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <div class="mb-4">
                        {% if user.image and user.image != 'default.png' %}
                            <img src="{{ asset('uploads/users/' ~ user.image) }}" alt="{{ user.name }}" class="rounded-circle img-thumbnail" style="width: 150px; height: 150px; object-fit: cover;">
                        {% else %}
                            <div class="user-avatar-placeholder rounded-circle mx-auto d-flex align-items-center justify-content-center" style="width: 150px; height: 150px; background-color: #e9ecef; font-size: 3rem; color: #adb5bd;">
                                <i class="bi bi-person"></i>
                            </div>
                        {% endif %}
                    </div>
                    
                    <h4 class="mb-1">{{ user.name }}</h4>
                    <p class="text-muted mb-3">
                        {% if user.role == 1 %}
                            <span class="badge bg-success">Enterprise</span>
                        {% elseif user.role == 2 %}
                            <span class="badge bg-primary">Job Seeker</span>
                        {% elseif user.role == 3 %}
                            <span class="badge bg-danger">Admin</span>
                        {% endif %}
                    </p>
                    
                    <a href="{{ path('app_profile_edit') }}" class="btn btn-primary w-100">
                        <i class="bi bi-pencil-square me-2"></i> Edit Profile
                    </a>
                </div>
            </div>
            
            {% if user.role == 2 %}
            <!-- Job Seeker specific card -->
            <div class="card shadow-sm mt-4">
                <div class="card-header">
                    <h5 class="mb-0">Quick Links</h5>
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush">
                        <a href="{{ path('app_cv') }}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-file-earmark-person me-2"></i> My CVs</span>
                            <span class="badge bg-primary rounded-pill">{{ user.cvs|length }}</span>
                        </a>
                        <a href="{{ path('app_application_job_index') }}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-briefcase me-2"></i> My Applications</span>
                            <span class="badge bg-primary rounded-pill">{{ user.jobApplications|length }}</span>
                        </a>
                    </div>
                </div>
            </div>
            {% endif %}
            
            {% if user.role == 1 %}
            <!-- Enterprise specific card -->
            <div class="card shadow-sm mt-4">
                <div class="card-header">
                    <h5 class="mb-0">Quick Links</h5>
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush">
                        <a href="{{ path('app_job_offer_index') }}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-briefcase me-2"></i> My Job Offers</span>
                            <span class="badge bg-success rounded-pill">{{ user.jobOffers|length }}</span>
                        </a>
                        <a href="#" class="list-group-item list-group-item-action">
                            <i class="bi bi-building me-2"></i> Company Profile
                        </a>
                    </div>
                </div>
            </div>
            {% endif %}
        </div>
        
        <div class="col-md-8">
            <!-- Flash messages -->
            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
            
            {% for message in app.flashes('error') %}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
            
            <!-- Profile Info Card -->
            <div class="card shadow-sm mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Profile Information</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-4 fw-bold">Name:</div>
                        <div class="col-md-8">{{ user.name }}</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-4 fw-bold">Email:</div>
                        <div class="col-md-8">{{ user.email }}</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-4 fw-bold">Account Type:</div>
                        <div class="col-md-8">
                            {% if user.role == 1 %}
                                Enterprise
                            {% elseif user.role == 2 %}
                                Job Seeker
                            {% elseif user.role == 3 %}
                                Administrator
                            {% endif %}
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-4 fw-bold">Authentication Method:</div>
                        <div class="col-md-8">
                            {% if user.auth_method %}
                                {{ user.auth_method|capitalize }}
                            {% else %}
                                Standard
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Activity Section -->
            {% if user.role == 2 %}
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Recent Applications</h5>
                </div>
                <div class="card-body">
                    {% if user.jobApplications is not empty %}
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Job Title</th>
                                    <th>Company</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for application in user.jobApplications|slice(0, 5) %}
                                <tr>
                                    <td>{{ application.job_offer.title }}</td>
                                    <td>{{ application.job_offer.user.name }}</td>
                                    <td>{{ application.date|date('Y-m-d') }}</td>
                                    <td>
                                        {% if application.status == 'pending' %}
                                            <span class="badge bg-warning">Pending</span>
                                        {% elseif application.status == 'accepted' %}
                                            <span class="badge bg-success">Accepted</span>
                                        {% elseif application.status == 'rejected' %}
                                            <span class="badge bg-danger">Rejected</span>
                                        {% endif %}
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% else %}
                    <p class="text-muted text-center py-3">You haven't applied to any jobs yet.</p>
                    {% endif %}
                </div>
            </div>
            {% endif %}
            
            {% if user.role == 1 %}
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Recent Job Offers</h5>
                </div>
                <div class="card-body">
                    {% if user.jobOffers is not empty %}
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Title</th>
                                    <th>Posted Date</th>
                                    <th>Applications</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for jobOffer in user.jobOffers|slice(0, 5) %}
                                <tr>
                                    <td>{{ jobOffer.title }}</td>
                                    <td>{{ jobOffer.created_at|date('Y-m-d') }}</td>
                                    <td>{{ jobOffer.applications|length }}</td>
                                    <td>
                                        {% if jobOffer.status == 'active' %}
                                            <span class="badge bg-success">Active</span>
                                        {% elseif jobOffer.status == 'closed' %}
                                            <span class="badge bg-secondary">Closed</span>
                                        {% endif %}
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% else %}
                    <p class="text-muted text-center py-3">You haven't posted any job offers yet.</p>
                    {% endif %}
                </div>
            </div>
            {% endif %}
            
            <!-- Account Security Section -->
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0">Account Security</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h6 class="mb-1">Password</h6>
                            <p class="text-muted small mb-0">Last changed: Not available</p>
                        </div>
                        <a href="{{ path('app_profile_edit') }}#password" class="btn btn-outline-primary btn-sm">
                            Change Password
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %} 