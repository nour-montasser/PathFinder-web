{% if current_user.role == 3 %}
    {# Vertical Backoffice Navbar for Admins (role=3) #}
    <div class="card backoffice-navbar" style="background-color: rgba(59, 38, 29, 0.95); width: 250px; height: 100vh; position: fixed; left: 0; top: 0; z-index: 1030;">
        <div class="card-body d-flex flex-column py-2 px-3">
            <!-- Logo -->
            <div class="mb-4 text-center">
                <a href="{{ path('app_home') }}">
                    <img src="{{ asset('build/images/logo/pathfinder_logo_white.png') }}" alt="Pathfinder Logo" class="navbar-logo" style="height: 70px;">
                </a>
            </div>

            <!-- Admin Navigation Links -->
            <div class="flex-grow-1">
                <ul class="nav nav-pills flex-column mb-0">
                    <li class="nav-item">
                        <a class="nav-link text-white" href="{{ path('admin_dashboard') }}">
                            <i class="bi bi-speedometer2 me-2"></i>
                            Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="{{ path('admin_users') }}">
                            <i class="bi bi-people me-2"></i>
                            Users
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="{{ path('admin_cvs') }}">
                            <i class="bi bi-file-earmark-person me-2"></i>
                            CVs
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="{{ path('admin_skill_tests') }}">
                            <i class="bi bi-clipboard-check me-2"></i>
                            Skill Tests
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="{{ path('admin_freelance') }}">
                            <i class="bi bi-people me-2"></i>
                            Freelance
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="{{ path('admin_job_offers') }}">
                            <i class="bi bi-briefcase me-2"></i>
                            Job Offers
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="{{ path('admin_chats') }}">
                            <i class="bi bi-chat-dots me-2"></i>
                            Chats
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="{{ path('admin_feedback') }}">
                            <i class="bi bi-emoji-expressionless me-2"></i>
                            Feedback
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Profile Section -->
            <div class="d-flex flex-column align-items-center mt-auto py-3" style="border-top: 1px solid rgba(255,255,255,0.1);">
                <a href="#" class="text-decoration-none text-white d-flex align-items-center">
                    <div class="avatar avatar-xl position-relative">
                        {% if current_user.image %}
                            <img src="{{ current_user.image }}" alt="Profile Picture" class="rounded-circle profile-image" style="width: 50px; height: 50px; object-fit: cover;">
                        {% else %}
                            <img src="{{ asset('build/images/faces/default-profile.png') }}" alt="Default Profile" class="rounded-circle profile-image" style="width: 50px; height: 50px; object-fit: cover;">
                        {% endif %}
                    </div>
                    <span class="ms-2 text-truncate" style="max-width: 150px;">
                        {{ current_user.name }}
                    </span>
                </a>
                <a href="#" class="btn btn-sm btn-outline-light w-100 mt-2">
                    <i class="bi bi-box-arrow-left me-1"></i>
                    Logout
                </a>
            </div>
        </div>
    </div>
{% else %}
    {# Horizontal Navbar for non-admin users #}
    <div class="card navbar-container fixed-top" style="z-index: 1030; background-color: rgba(59, 38, 29, 0.95);">
        <div class="card-body d-flex align-items-center py-2 px-3">
            <!-- Logo -->
            <div class="me-4">
                <a href="{{ path('app_home') }}">
                    <img src="{{ asset('build/images/logo/pathfinder_logo_white.png') }}" alt="Pathfinder Logo" class="navbar-logo" style="height: 70px;">
                </a>
            </div>

            <!-- Navigation -->
            <div class="flex-grow-1 d-flex justify-content-center">
                <ul class="nav nav-tabs mb-0" style="flex-wrap: nowrap;">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_home') }}">
                            <i class="bi bi-house-door me-2"></i>
                            Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_job_offer_index') }}">
                            <i class="bi bi-briefcase me-2"></i>
                            Job Offers
                        </a>
                    </li>

                    {% if current_user.role == 1 %}
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_skilltest_index') }}">
                                <i class="bi bi-clipboard-check me-2"></i>
                                Skill Tests
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_job_offer_dashboard') }}">
                                <i class="bi bi-speedometer2 me-2"></i>
                                Dashboard
                            </a>
                        </li>
                    {% elseif current_user.role == 2 %}
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_application_job_index') }}">
                                <i class="bi bi-file-earmark-text me-2"></i>
                                Applications
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('cv_show') }}">
                                <i class="bi bi-file-earmark-person me-2"></i>
                                CV
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_freelance') }}">
                                <i class="bi bi-people me-2"></i>
                                Freelance
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_message_index') }}">
                                <i class="bi bi-chat-dots me-2"></i>
                                Chat
                            </a>
                        </li>
                    {% endif %}
                </ul>
            </div>

            <!-- Profile & Auth -->
            <div class="d-flex align-items-center ms-auto" style="gap: 1rem;">
                {% if current_user %}
                    <a href="#" class="text-decoration-none text-white d-flex align-items-center">
                        <div class="avatar avatar-xl position-relative">
                            {% if current_user.image %}
                                <img src="{{ current_user.image }}" alt="Profile Picture" class="rounded-circle profile-image" style="width: 50px; height: 50px; object-fit: cover;">
                            {% else %}
                                <img src="{{ asset('build/images/faces/default-profile.png') }}" alt="Default Profile" class="rounded-circle profile-image" style="width: 50px; height: 50px; object-fit: cover;">
                            {% endif %}
                        </div>
                        <span class="ms-2 d-none d-lg-inline text-truncate" style="max-width: 80px;">
                            {{ current_user.name }}
                        </span>
                    </a>
                    <a href="#" class="btn btn-sm btn-outline-light">
                        <i class="bi bi-box-arrow-left me-1"></i>
                        Logout
                    </a>
                {% else %}
                    <a href="#" class="btn btn-sm btn-outline-light">
                        <i class="bi bi-box-arrow-in-right me-1"></i>
                        Login
                    </a>
                {% endif %}
            </div>
        </div>
    </div>
{% endif %}