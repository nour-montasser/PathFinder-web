<div class="card navbar-container fixed-top" style="z-index: 1030; background-color: rgba(59, 38, 29, 0.95);">
    <div class="card-body d-flex align-items-center py-2 px-3">
        <!-- Logo linking to home -->
        <div class="me-4">
            <a href="{{ path('app_home') }}">
                <img src="{{ asset('build/images/logo/pathfinder_logo_white.png') }}" 
                     alt="Pathfinder Logo" 
                     class="navbar-logo" style="height: 70px;"> <!-- Reduced height -->
            </a>
        </div>
        
        <!-- Navigation Links with Routes -->
        <div class="flex-grow-1 d-flex justify-content-center">
            <ul class="nav nav-tabs mb-0" id="myTab" role="tablist" style="flex-wrap: nowrap;"> <!-- Added flex-wrap -->
                <li class="nav-item" role="presentation">
                    <a class="nav-link {{ app.request.get('_route') == 'app_home' ? 'active' : '' }}" 
                       href="{{ path('app_home') }}">
                        <i class="bi bi-house-door me-2"></i> Home
                    </a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link {{ app.request.get('_route') == 'app_JobOffer' ? 'active' : '' }}" 
                       href="{{ path('app_job_offer_index') }}">
                        <i class="bi bi-briefcase me-2"></i> Job Offers
                    </a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link {{ app.request.get('_route') == 'app_application' ? 'active' : '' }}" 
                       href="{{ path('app_application_job_index') }}">
                        <i class="bi bi-file-earmark-text me-2"></i> Applications
                    </a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link {{ app.request.get('_route') == 'app_cv' ? 'active' : '' }}" 
                       href="{{ path('app_cv') }}">
                        <i class="bi bi-file-earmark-person me-2"></i> CV
                    </a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link {{ app.request.get('_route') == 'app_skill_test' ? 'active' : '' }}" 
                       href="{{ path('app_skill_test') }}">
                        <i class="bi bi-clipboard-check me-2"></i> Skill Tests
                    </a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link {{ app.request.get('_route') == 'app_freelance' ? 'active' : '' }}" 
                       href="{{ path('app_freelance') }}">
                        <i class="bi bi-people me-2"></i> Freelance
                    </a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link {{ app.request.get('_route') == 'app_chat' ? 'active' : '' }}" 
                       href="{{ path('app_chat') }}">
                        <i class="bi bi-chat-dots me-2"></i> Chat
                    </a>
                </li>
            </ul>
        </div>
        
        <!-- Profile Section - Improved layout -->
        <div class="d-flex align-items-center ms-auto" style="gap: 1rem;">
            {% if current_user %}
                <a href="#" class="text-decoration-none text-white d-flex align-items-center">
                    <div class="avatar avatar-xl position-relative">
                        {% if current_user.image %}
                            <img src="{{ current_user.image }}" 
                                 alt="Profile Picture" 
                                 class="rounded-circle profile-image"
                                 style="width: 50px; height: 50px; object-fit: cover;">
                        {% else %}
                            <img src="{{ asset('build/images/faces/default-profile.png') }}" 
                                 alt="Default Profile" 
                                 class="rounded-circle profile-image"
                                 style="width: 0px; height: 50px; object-fit: cover;">
                        {% endif %}
                    </div>
                      <span class="ms-2 d-none d-lg-inline text-truncate" style="max-width: 80px;">
                        {{ current_user.name }}
                    </span>
                </a>
                <a href="#" class="btn btn-sm btn-outline-light">
                    <i class="bi bi-box-arrow-left me-1"></i> Logout
                </a>
            {% else %}
                <a href="#" class="btn btn-sm btn-outline-light">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Login
                </a>
            {% endif %}
        </div>
    </div>
</div>