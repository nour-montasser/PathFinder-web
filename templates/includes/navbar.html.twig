{# templates/_navbar.html.twig #}
<nav class="navbar navbar-expand-lg fixed-top" style="background-color: rgba(59, 38, 29, 0.95); z-index: 1030;">
  <div class="container-fluid px-3">
    <!-- Logo / Brand -->
    <a class="navbar-brand d-flex align-items-center" href="{{ path('app_home') }}">
      <!-- Make the logo bigger (height: 70px, for example) -->
      <img src="{{ asset('build/images/logo/pathfinder_logo_white.png') }}" 
           alt="Pathfinder Logo"
           style="height: 70px;"
           class="me-2">
      {# Optionally, if you want text:
         <span class="text-white fw-bold">Pathfinder</span>
      #}
    </a>

    <!-- Toggler for mobile screens -->
    <button class="navbar-toggler text-white border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
      aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation" style="box-shadow: none;">
      <i class="bi bi-list" style="font-size: 1.5rem; color: #fff;"></i>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <!-- Navigation Links -->
      <ul class="navbar-nav me-auto mb-2 mb-lg-0 nav-animate">
        <li class="nav-item">
          <a class="nav-link {% if app.request.get('_route') == 'app_home' %}active{% endif %}"
             href="{{ path('app_home') }}">
            <i class="bi bi-house-door me-1"></i> Home
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link {% if app.request.get('_route') == 'app_job_offer' %}active{% endif %}"
             href="{{ path('app_job_offer') }}">
            <i class="bi bi-briefcase me-1"></i> Job Offers
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link {% if app.request.get('_route') == 'app_application' %}active{% endif %}"
             href="{{ path('app_application') }}">
            <i class="bi bi-file-earmark-text me-1"></i> Applications
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link {% if app.request.get('_route') == 'app_cv' %}active{% endif %}"
             href="{{ path('app_cv') }}">
            <i class="bi bi-file-earmark-person me-1"></i> CV
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link {% if app.request.get('_route') == 'app_skill_test' %}active{% endif %}"
             href="{{ path('app_skill_test') }}">
            <i class="bi bi-clipboard-check me-1"></i> Skill Tests
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link {% if app.request.get('_route') == 'app_serviceoffre_index' %}active{% endif %}"
             href="{{ path('app_serviceoffre_index') }}">
            <i class="bi bi-people me-1"></i> Freelance
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link {% if app.request.get('_route') == 'app_chat' %}active{% endif %}"
             href="{{ path('app_chat') }}">
            <i class="bi bi-chat-dots me-1"></i> Chat
          </a>
        </li>
      </ul>

      <!-- Subtle Search Bar -->
      <form class="d-flex me-3" role="search">
        <div class="input-group input-group-sm">
          <input class="form-control border-0" type="search" placeholder="Search" aria-label="Search"
                 style="border-radius: 20px 0 0 20px;">
          <button class="btn btn-outline-light" type="submit" style="border-radius: 0 20px 20px 0;">
            <i class="bi bi-search"></i>
          </button>
        </div>
      </form>

      <!-- Profile Avatar & Logout -->
      <div class="d-flex align-items-center" style="gap: 0.5rem;">
        <a href="{{ path('app_profile') }}" class="text-decoration-none">
          <img src="{{ asset('build/images/faces/5.jpg') }}" alt="User Avatar"
               class="rounded-circle profile-hover"
               style="height: 35px; width: 35px; object-fit: cover;">
        </a>
        <a href="#" class="btn btn-sm btn-outline-light py-1 px-2">
          <i class="bi bi-box-arrow-left me-1"></i> Logout
        </a>
      </div>
    </div>
  </div>
</nav>

<style>
/* Spacing and transitions for nav links */
.nav-animate .nav-link {
  color: #fff;                  /* White text by default */
  margin: 0 0.8rem;             /* More space between each item */
  transition: all 0.3s ease;    /* Animate color, size, etc. */
  font-size: 0.95rem;           /* Slightly smaller base font */
}

.nav-animate .nav-link:hover {
  color: #FFD700 !important;    /* Change to gold on hover */
  font-size: 1.05rem;           /* Slightly bigger font on hover */
  transform: scale(1.05);       /* Subtle scaling effect */
}

/* Active link style (if using .active) */
.nav-animate .nav-link.active {
  color: #FFD700 !important;
  font-weight: 600;
}

/* Profile image hover: scale effect */
.profile-hover {
  transition: transform 0.3s ease;
}
.profile-hover:hover {
  transform: scale(1.15);
}

/* Adjust the outline button color on hover */
.btn-outline-light:hover {
  background-color: #fff;
  color: #3B261D;
}
</style>
