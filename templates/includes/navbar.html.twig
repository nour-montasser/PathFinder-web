{% if current_user is defined and current_user is not null %}
    {% if current_user.role == 3 %}
        {# Vertical Sidebar for Admin (Role 3) #}
        <aside class="position-fixed h-100 bg-dark text-white" style="width: 220px; z-index: 1030; top: 0; left: 0;">
            <div class="d-flex flex-column h-100 p-3">
                <!-- Logo -->
                <div class="text-center mb-4">
                    <a href="{{ path('app_home') }}">
                        <img src="{{ asset('build/images/logo/pathfinder_logo_white.png') }}" alt="Pathfinder Logo" style="height: 36px;">
                    </a>
                </div>

                <!-- Admin Navigation -->
                <nav class="flex-grow-1">
                    <ul class="nav flex-column gap-2">
                        <li><a class="nav-link text-white" href="{{ path('admin_dashboard') }}"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
                        <li><a class="nav-link text-white" href="{{ path('admin_users') }}"><i class="bi bi-people me-2"></i>Users</a></li>
                        <li><a class="nav-link text-white" href="{{ path('admin_cvs') }}"><i class="bi bi-file-earmark-person me-2"></i>CVs</a></li>
                        
                        
                        <li><a class="nav-link text-white" href="{{ path('admin_job_offers') }}"><i class="bi bi-briefcase me-2"></i>Job Offers</a></li>
                        <li><a class="nav-link text-white" href="{{ path('admin_chats') }}"><i class="bi bi-chat-dots me-2"></i>Chats</a></li>
                        <li><a class="nav-link text-white" href="{{ path('admin_feedback') }}"><i class="bi bi-emoji-expressionless me-2"></i>Feedback</a></li>
                    </ul>
                </nav>

                 <!-- Profile Section -->
            <div class="d-flex flex-column align-items-center mt-auto py-2" style="border-top: 1px solid rgba(255,255,255,0.1);">
                <a href="{{ path('app_profile') }}" class="text-decoration-none text-white d-flex align-items-center">
                    <div class="avatar avatar-xl position-relative">
                        {% if current_user.image %}
                            <img src="{{ current_user.image }}" alt="Profile Picture" class="rounded-circle profile-image" style="width: 40px; height: 40px; object-fit: cover;">
                        {% else %}
                            <img src="{{ asset('build/images/faces/default-profile.png') }}" alt="Default Profile" class="rounded-circle profile-image" style="width: 40px; height: 40px; object-fit: cover;">
                        {% endif %}
                    </div>
                    <span class="ms-2 text-truncate" style="max-width: 150px; font-size: 0.9rem;">
                        {{ current_user.name }}
                    </span>
                </a>
                <a href="{{ path('app_logout') }}" class="btn btn-sm btn-outline-light w-100 mt-1" style="font-size: 0.85rem;">
                    <i class="bi bi-box-arrow-left me-1"></i>
                    Logout
                </a>
            </div>
            </div>
        </aside>
    {% elseif current_user.role is not null %}
        {# Horizontal Navbar for Roles 1, 2, and 4 #}
        <nav class="navbar navbar-expand-lg fixed-top" style="background-color: rgba(59,38,29,0.95); z-index:1030;">
            <div class="container-fluid px-4">
                <!-- Logo -->
                <a class="navbar-brand text-white" href="{{ path('app_home') }}">
                    <img src="{{ asset('build/images/logo/pathfinder_logo_white.png') }}" alt="Logo" style="height: 36px;">
                </a>

                <!-- Navigation -->
                <div class="collapse navbar-collapse justify-content-center">
                    <ul class="navbar-nav gap-3">
                        <li class="nav-item"><a class="nav-link text-white" href="{{ path('app_home') }}"><i class="bi bi-house-door me-1"></i>Home</a></li>
                        <li class="nav-item"><a class="nav-link text-white" href="{{ path('app_job_offer_index') }}"><i class="bi bi-briefcase me-1"></i>Jobs</a></li>

                        {% if current_user.role == 1 %}
                            <li class="nav-item"><a class="nav-link text-white" href="{{ path('app_skilltest_index') }}"><i class="bi bi-clipboard-check me-1"></i>Tests</a></li>
                            <li class="nav-item"><a class="nav-link text-white" href="{{ path('app_job_offer_dashboard') }}"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a></li>

                        {% elseif current_user.role == 2 %}
                            <li class="nav-item"><a class="nav-link text-white" href="{{ path('app_application_job_index') }}"><i class="bi bi-file-earmark-text me-1"></i>Applications</a></li>
                            <li class="nav-item"><a class="nav-link text-white" href="{{ path('cv_show') }}"><i class="bi bi-file-earmark-person me-1"></i>CV</a></li>
                            <li class="nav-item"><a class="nav-link text-white" href="{{ path('app_freelance_guide') }}"><i class="bi bi-people me-1"></i>Freelance</a></li>
                            <li class="nav-item"><a class="nav-link text-white" href="{{ path('app_message_index') }}"><i class="bi bi-chat-dots me-1"></i>Chat</a></li>

                        {% elseif current_user.role == 4 %}
                            <li class="nav-item"><a class="nav-link text-white" href="{{ path('app_freelance_guide') }}"><i class="bi bi-briefcase me-1"></i>My Services</a></li>
                            <li class="nav-item"><a class="nav-link text-white" href="{{ path('app_message_index') }}"><i class="bi bi-chat-dots me-1"></i>Chat</a></li>
                        {% endif %}
                    </ul>
                </div>

                 <!-- Profile & Auth -->
            <div class="d-flex align-items-center ms-auto" style="gap: 0.5rem;">
                {% if current_user %}
                    <a href="{{ path('app_profile') }}" class="text-decoration-none text-white d-flex align-items-center">
                        <div class="avatar avatar-xl position-relative">
                            {% if current_user.image %}
                                <img src="{{ current_user.image }}" alt="Profile Picture" class="rounded-circle profile-image" style="width: 40px; height: 40px; object-fit: cover;">
                            {% else %}
                                <img src="{{ asset('build/images/faces/default-profile.png') }}" alt="Default Profile" class="rounded-circle profile-image" style="width: 40px; height: 40px; object-fit: cover;">
                            {% endif %}
                        </div>
                        <span class="ms-2 d-none d-lg-inline text-truncate" style="max-width: 80px; font-size: 0.9rem;">
                            {{ current_user.name }}
                        </span>
                    </a>
                    <a href="{{ path('app_logout') }}" class="btn btn-sm btn-outline-light" style="font-size: 0.85rem;">
                        <i class="bi bi-box-arrow-left me-1"></i>
                        Logout
                    </a>
                {% else %}
                    <a href="#" class="btn btn-sm btn-outline-light" style="font-size: 0.85rem;">
                        <i class="bi bi-box-arrow-in-right me-1"></i>
                        Login
                    </a>
                {% endif %}
            </div>
            </div>
        </nav>
    {% endif %}
{% endif %}