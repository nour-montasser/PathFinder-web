{% extends 'base.html.twig' %}
{% block title %}Take {{ skilltest.title }}{% endblock %}

{% block body %}
    <style>
        /* Same CSS you gave - no change */
        #timer {
            font-size: 1.2rem;
            color: #dc3545;
            text-align: center;
            margin-bottom: 20px;
        }

        .progress-container {
            width: 100%;
            background-color: #eee;
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 20px;
            height: 20px;
        }

        .progress-bar {
            height: 100%;
            width: 0%;
            background-color: #2ecc71;
            text-align: center;
            color: white;
            font-weight: bold;
            font-size: 14px;
            line-height: 20px;
            transition: width 0.3s ease;
        }

        .skilltest-form-container {
            max-width: 800px;
            margin: 50px auto;
            background-color: #fefaf7;
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
            font-family: 'Segoe UI', sans-serif;
        }

        .skilltest-form-container h2 {
            color: #3B261D;
            margin-bottom: 30px;
            font-weight: bold;
            font-size: 28px;
            text-align: center;
        }

        .question-block {
            margin-bottom: 30px;
        }

        .question-block p {
            font-weight: 600;
            color: #333;
            font-size: 18px;
            margin-bottom: 10px;
        }

        .form-check {
            background: #fff;
            border: 1px solid #ddd;
            padding: 12px 15px;
            border-radius: 8px;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            transition: all 0.2s ease;
        }

        .form-check:hover {
            border-color: #aaa;
            background-color: #fcfcfc;
        }

        .form-check-input {
            margin-right: 12px;
            accent-color: #2ecc71;
            transform: scale(1.2);
        }

        .form-check-label {
            font-size: 16px;
            color: #2c3e50;
            font-weight: 500;
        }

        .btn-submit {
            background-color: #2ecc71;
            color: white;
            border: none;
            padding: 12px 25px;
            font-weight: bold;
            font-size: 16px;
            border-radius: 8px;
            transition: background 0.3s ease;
        }

        .btn-submit:hover {
            background-color: #27ae60;
        }
    </style>

    <div class="skilltest-form-container">
        <h2>🧪 {{ skilltest.title }}</h2>

        <!-- 🟢 Timer -->
        <div id="timer">⏳ Time Left: <span id="countdown"></span></div>

        <!-- 🟢 Progress Bar -->
        <div class="progress-container">
            <div id="progressBar" class="progress-bar">0%</div>
        </div>

        <form method="POST">
            {% for question in pagination %}
                <div class="question-block">
                    <p>{{ loop.index }}. {{ question.question }}</p>
                    {% set responses = question.responses|split(',') %}
                    {% for response in responses %}
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="question_{{ question.id }}" value="{{ response }}" required>
                            <label class="form-check-label">{{ response }}</label>
                        </div>
                    {% endfor %}
                </div>
            {% endfor %}

            {{ knp_pagination_render(pagination) }}

            {% if pagination.currentPageNumber == pagination.pageCount %}
                <!-- Only show the submit button on the last page -->
                <button type="submit" class="btn-submit mt-3">✅ Submit Test</button>
            {% endif %}
        </form>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Timer
            let totalMinutes = {{ skilltest.duration }};
            let duration = totalMinutes * 60;
            const countdown = document.getElementById('countdown');
            const form = document.querySelector('form');

            const timer = setInterval(() => {
                const minutes = Math.floor(duration / 60);
                const seconds = duration % 60;
                countdown.textContent = `${minutes}:${seconds < 10 ? '0' : ''}${seconds}`;

                if (duration <= 0) {
                    clearInterval(timer);
                    alert("⏱️ Time's up! Submitting your answers...");
                    form.submit();
                }

                duration--;
            }, 1000);

            // Progress Bar
            const totalQuestions = {{ skilltest.questions|length }};
            const currentPage = {{ pagination.currentPageNumber }};
            const progressBar = document.getElementById('progressBar');

            const percentage = Math.floor((currentPage / totalQuestions) * 100);
            progressBar.style.width = percentage + '%';
            progressBar.textContent = percentage + '%';
        });
    </script>
{% endblock %}
