{% extends 'base.html.twig' %}
{% block title %}Take {{ skilltest.title }}{% endblock %}

{% block body %}
    <style>
        .skilltest-form-container {
            max-width: 800px;
            margin: 50px auto;
            background-color: #fefaf7;
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
            font-family: 'Segoe UI', sans-serif;
        }

        .skilltest-form-container h2 {
            color: #3B261D;
            margin-bottom: 30px;
            font-weight: bold;
            font-size: 28px;
        }

        .question-block {
            margin-bottom: 30px;
        }

        .question-block p {
            font-weight: 600;
            color: #333;
            font-size: 18px;
            margin-bottom: 10px;
        }

        .form-check {
            background: #fff;
            border: 1px solid #ddd;
            padding: 12px 15px;
            border-radius: 8px;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            transition: all 0.2s ease;
        }

        .form-check:hover {
            border-color: #aaa;
            background-color: #fcfcfc;
        }

        .form-check-input {
            margin-right: 12px;
            accent-color: #2ecc71; /* green radio when selected */
            transform: scale(1.2);
        }

        .form-check-label {
            font-size: 16px;
            color: #2c3e50;
            font-weight: 500;
        }


        .form-check-input {
            margin-right: 8px;
        }

        .btn-submit {
            background-color: #2ecc71;
            color: white;
            border: none;
            padding: 12px 25px;
            font-weight: bold;
            font-size: 16px;
            border-radius: 8px;
            transition: background 0.3s ease;
        }

        .btn-submit:hover {
            background-color: #27ae60;
        }
    </style>

    <div class="skilltest-form-container">
        <h2>🧪 {{ skilltest.title }}</h2>
        <form method="POST">
            {% for question in skilltest.questions %}
                <div class="question-block">
                    <p>{{ loop.index }}. {{ question.question }}</p>
                    {% set responses = question.responses|split(',') %}
                    {% for response in responses %}
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="question_{{ question.id }}" value="{{ response }}" required>
                            <label class="form-check-label">{{ response }}</label>
                        </div>
                    {% endfor %}
                </div>
            {% endfor %}
            <button type="submit" class="btn-submit mt-3">✅ Submit Test</button>
        </form>
    </div>
{% endblock %}
