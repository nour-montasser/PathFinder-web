{% extends 'base.html.twig' %}

{% block title %}Advanced Search{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h2 class="text-center mb-4">
            🔍 <span style="color: #5a3e2e;">Advanced SkillTest Search</span>
        </h2>

        <div class="row g-3 justify-content-center mb-4">
            <div class="col-md-8">
                <input type="text" id="titleFilter" class="form-control custom-input" placeholder="Search by title...">
            </div>
            <div class="col-md-4">
                <input type="number" id="durationFilter" class="form-control custom-input" placeholder="Max duration...">
            </div>
            <div class="col-md-4">
                <input type="number" id="scoreFilter" class="form-control custom-input" placeholder="Minimum score required...">
            </div>
        </div>

        <div id="resultsContainer" class="container mt-4">
            <!-- AJAX results go here -->
        </div>
    </div>

    <style>
        .custom-input {
            border-radius: 10px;
            border: 1px solid #ddd0c5;
            padding: 10px 15px;
            font-size: 1rem;
            background-color: #fefbf9;
            box-shadow: 0 1px 3px rgba(90, 62, 46, 0.08);
            transition: border-color 0.2s ease;
        }

        .custom-input:focus {
            outline: none;
            border-color: #5a3e2e;
            box-shadow: 0 0 0 2px rgba(90, 62, 46, 0.2);
        }

        ::placeholder {
            color: #a08c7d;
            font-style: italic;
        }
    </style>

{% endblock %}

{% block javascripts %}
    <script>
        function performSearch() {
            const title = document.getElementById('titleFilter').value;
            const duration = document.getElementById('durationFilter').value;
            const score = document.getElementById('scoreFilter').value;

            const xhr = new XMLHttpRequest();
            xhr.open('GET', `{{ path('app_skilltest_search') }}?title=${title}&duration=${duration}&score=${score}`, true);
            xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');
            xhr.onload = function () {
                if (xhr.status === 200) {
                    document.getElementById('resultsContainer').innerHTML = xhr.responseText;
                }
            };
            xhr.send();
        }

        document.addEventListener('DOMContentLoaded', () => {
            ['titleFilter', 'durationFilter', 'scoreFilter'].forEach(id => {
                document.getElementById(id).addEventListener('input', performSearch);
            });
        });
    </script>
{% endblock %}
