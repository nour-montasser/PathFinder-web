{% extends 'base.html.twig' %}

{% block title %}SkillTest Result{% endblock %}

{% block body %}
    <div class="container mt-5 text-center">

        <h2>🧪 {{ skilltest.title }}</h2>
        <p>Your Score: <strong>{{ score }}/{{ total }}</strong></p>
        <p>Percentage: <strong>{{ percentage|number_format(1) }}%</strong></p>
        <p>Status:
            {% if passed %}
                <span class="text-success">✅ Passed</span>
            {% else %}
                <span class="text-danger">❌ Failed</span>
            {% endif %}
        </p>

        {% if form is defined and form is not null %}
            <h4 class="mt-4 text-warning fw-bold fs-4">⭐ Rate This SkillTest</h4>
            <form method="POST">
                <div class="star-rating">
                    {% for i in 5..1 %}
                        <input type="radio" name="test_result[rating]" id="star{{ i }}" value="{{ i }}" {% if form.rating.vars.value == i %}checked{% endif %}>
                        <label for="star{{ i }}">★</label>
                    {% endfor %}
                </div>
                <button class="btn btn-success mt-3">Submit Rating</button>
            </form>
        {% else %}
            <div class="text-muted mt-4 fw-bold fs-5">
                ⭐ You have already rated this test.
            </div>
            <div class="star-rating read-only mt-2">
                {% for i in 5..1 %}
                    <label class="{% if test_result.getRating() >= i %}rated{% endif %}">★</label>
                {% endfor %}
            </div>
        {% endif %}

        <div class="mt-5">
            <h5 class="fw-bold text-danger">❓ Still confused? Ask the AI Assistant</h5>
            <textarea id="userPromptInput" class="form-control" placeholder="Ask something about the test..." rows="3"></textarea>

            <input type="hidden" id="skilltestId" value="{{ skilltest.id }}">

            <button id="ask-button" class="btn btn-info mt-3">Ask AI</button>

            <div id="aiResponse" class="mt-3 text-start" style="white-space: pre-wrap;">
                <i class="text-muted">🤖 No response yet.</i>
            </div>
        </div>

        <a href="{{ path('app_skilltest_pdf', { id: skilltest.id }) }}" class="btn btn-outline-dark mt-4">
            📄 Télécharger le résultat en PDF
        </a>

        <a href="{{ path('app_skilltest_index') }}" class="btn btn-outline-primary mt-2">
            ← Back to SkillTests
        </a>

    </div>

    <script>
        document.getElementById('ask-button').addEventListener('click', () => {
            const question = document.getElementById('userPromptInput').value;
            const answerEl = document.getElementById('aiResponse');

            answerEl.innerHTML = '🤖 Thinking...';

            fetch('/skilltest/ai/ask', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'question=' + encodeURIComponent(question)
            })

                    .then(response => response.json())
                .then(data => {
                    if (data.response) {
                        answerEl.innerHTML = '💬 ' + data.response;
                    } else if (data.error) {
                        answerEl.innerHTML = '⚠️ Error: ' + data.error;
                    } else {
                        answerEl.innerHTML = '⚠️ Unknown error.';
                    }
                })
                .catch(() => {
                    answerEl.innerHTML = '⚠️ An unexpected error occurred.';
                });
        });
    </script>




    <style>
        .star-rating {
            direction: rtl;
            display: flex;
            justify-content: center;
            gap: 5px;
            font-size: 2.5rem;
        }

        .star-rating input[type="radio"] {
            display: none;
        }

        .star-rating label {
            color: #ccc;
            cursor: pointer;
            transition: color 0.2s;
        }

        .star-rating input[type="radio"]:checked ~ label,
        .star-rating label:hover,
        .star-rating label:hover ~ label {
            color: gold;
        }

        .read-only {
            pointer-events: none;
        }

        .read-only label {
            color: #ccc;
        }

        .read-only label.rated {
            color: gold;
        }
    </style>
{% endblock %}
