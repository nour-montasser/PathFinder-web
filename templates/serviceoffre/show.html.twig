{% extends 'base.html.twig' %}

{% block title %}Service Offer Details{% endblock %}

{% block body %}
    <div class="container">
        <h1 class="my-4">Service Offer Details</h1>

        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h2>{{ serviceoffre.title }}</h2>
                <small>Posted on: {{ serviceoffre.datePosted ? serviceoffre.datePosted|date('F j, Y H:i') : 'N/A' }}</small>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <h5>Basic Information</h5>
                        <p><strong>Field:</strong> {{ serviceoffre.field }}</p>
                        <p><strong>Price:</strong> ${{ serviceoffre.price|number_format(2) }}</p>
                        <p><strong>Duration:</strong> {{ serviceoffre.duration }}</p>
                        <p><strong>Status:</strong> <span class="badge bg-{{ serviceoffre.status == 'active' ? 'success' : 'secondary' }}">{{ serviceoffre.status }}</span></p>
                    </div>
                    <div class="col-md-6">
                        <h5>Requirements</h5>
                        <p><strong>Required Education:</strong> {{ serviceoffre.requiredEducation }}</p>
                        <p><strong>Experience Level:</strong> {{ serviceoffre.experienceLevel }}</p>
                        <p><strong>Skills:</strong> {{ serviceoffre.skills }}</p>
                    </div>
                </div>
                
                <h5>Description</h5>
                <div class="border p-3 mb-3">
                    {{ serviceoffre.description|nl2br }}
                </div>
                
                <div class="d-flex justify-content-between mt-4">
                    <a href="{{ path('app_serviceoffre_index') }}" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Back to list
                    </a>
                    
                    <div>
                        <a href="{{ path('app_serviceoffre_edit', {'idService': serviceoffre.idService}) }}" class="btn btn-primary">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                        {{ include('serviceoffre/_delete_form.html.twig') }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}