{% set isOwner = sessionUser and service.user and sessionUser.idUser == service.user.idUser %}

<a href="{{
    isOwner
      ? path('app_serviceoffre_manage', { idService: service.idService })
      : '#'
  }}"
  {% if not isOwner %} onclick="openDrawer({{ service.idService }})" {% endif %}
  class="text-decoration-none text-reset w-100 d-block"
  style="cursor: pointer;"
>
  <div class="card p-4 shadow-sm border-0 h-100 position-relative card-hover">

    <small class="text-muted mb-2">
      Posted on {{ service.datePosted|date('F j, Y') }}
    </small>

    <div class="d-flex justify-content-between align-items-start">
      <div>
        <h5 class="fw-bold text-dark mb-1 service-title">
          {{ service.title }}
        </h5>

        <p class="text-muted mb-2">
          {{ service.description }}
        </p>

        <div class="d-flex gap-3 small text-muted mb-2">
  <span>
    <strong>Budget:</strong> 
    <span class="service-price" id="price-{{ service.idService }}" data-usd-price="{{ service.price }}">
      ${{ service.price }}
    </span>
  </span>
  
  <span><strong>Duration:</strong> {{ service.duration }}</span>
  <span><strong>Experience:</strong> {{ service.experienceLevel }}</span>
</div>


        {% for skill in service.skills|split(',') %}
          <span class="badge bg-light text-muted border px-2 py-1 rounded-pill me-2">
            {{ skill|trim }}
          </span>
        {% endfor %}
      </div>

      {% if isOwner %}
        <div class="dropdown">
          <button class="btn btn-sm btn-link text-dark p-0" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-three-dots-vertical fs-5"></i>
          </button>
          <ul class="dropdown-menu dropdown-menu-end">
            <li>
              <a class="dropdown-item text-danger"
                href="{{ path('app_serviceoffre_delete', { idService: service.idService }) }}"
                onclick="return confirm('Are you sure you want to delete this service?');">
                <i class="bi bi-trash me-2"></i> Delete
              </a>
            </li>
            <li>
              <a class="dropdown-item"
                href="{{ path('app_serviceoffre_show', { idService: service.idService }) }}">
                <i class="bi bi-list-ul me-2"></i> View Applications
              </a>
            </li>
          </ul>
        </div>
      {% endif %}
    </div>

    {% if not isOwner %}
      <div class="mt-3 text-end">
        <button class="btn btn-apply animate__animated animate__fadeIn"
          onclick="event.stopPropagation(); openApplyModal({{ service.idService }})">
          <i class="bi bi-send-fill me-1"></i> Apply
        </button>
      </div>
    {% endif %}
  </div>
</a>

<!-- Styles -->
<style>
  .card-hover {
    transition: box-shadow 0.3s ease;
  }

  .card-hover:hover {
    box-shadow: 0 0 0 0.3rem rgba(59, 38, 29, 0.08);
  }

  .service-title {
    transition: all 0.2s ease-in-out;
    display: inline-block;
    border-bottom: 2px solid transparent;
    color: #212529;
  }

  .card-hover:hover .service-title {
    color: #6f4f1f;
    border-color: #6f4f1f;
  }

  .btn-apply {
    background-color: #6f4f1f;
    color: white;
    border: none;
    padding: 6px 16px;
    font-size: 0.9rem;
    border-radius: 30px;
    transition: all 0.25s ease-in-out;
  }

  .btn-apply:hover {
    background-color: #5a3c16;
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.15);
    transform: translateY(-1px);
  }
  .card p.text-muted {
  max-height: 4.5em; /* ~3 lignes */
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 3; /* nombre de lignes */
  -webkit-box-orient: vertical;
  white-space: normal;
  word-break: break-word;
}

</style>

<!-- Animate.css (for smooth button effect) -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>

<!-- Modal trigger script -->
<script>
  function openApplyModal(id) {
    fetch(`/serviceoffre/${id}/apply`, {
      headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(res => res.text())
    .then(html => {
      document.getElementById('applyModalContent').innerHTML = html;
      new bootstrap.Modal(document.getElementById('applyModal')).show();
    });
  }



document.addEventListener('DOMContentLoaded', function() {
    const currencySelector = document.getElementById('currencySelector');
    const servicePrices = document.querySelectorAll('.service-price');

    currencySelector.addEventListener('change', function() {
        const selectedCurrency = this.value;

        fetch(`/convert-currency?to=${selectedCurrency}`)
            .then(response => response.json())
            .then(data => {
                if (data.rate) {
                    servicePrices.forEach(function(priceElement) {
                        const usdPrice = parseFloat(priceElement.getAttribute('data-usd-price'));
                        const convertedPrice = (usdPrice * data.rate).toFixed(2);

                        priceElement.innerText = `${convertedPrice} ${selectedCurrency}`;
                    });
                } else {
                    console.error('Conversion error:', data.error);
                }
            })
            .catch(error => {
                console.error('Error during conversion:', error);
            });
    });
});


</script>
