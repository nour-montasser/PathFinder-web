{% extends 'base.html.twig' %}

{% block title %}Manage Service: {{ serviceoffre.title }}{% endblock %}

{% block body %}
<div class="container-fluid py-5" style="background-color: #F8F9FA; min-height: 100vh;">
  <div class="container">

    <!-- Success Banner -->
    <div class="alert alert-success d-flex justify-content-between align-items-center rounded shadow-sm px-4 py-3" role="alert">
      <div>
        ✅ <strong>Your service post is live.</strong> Invite top talent fast before they’re booked.
      </div>
      <button class="btn btn-sm btn-outline-success rounded-pill fw-semibold">Feature this service</button>
    </div>

    <!-- Progress Tracker Tabs -->
    <div class="snickers-progress-bar d-flex align-items-stretch text-center mb-4 rounded overflow-hidden">
      <div class="step-snicker flex-fill active" data-tab="job">
        <span>View Job Post</span>
      </div>
      <div class="step-snicker flex-fill" data-tab="proposals">
       <span>Review Proposals (
  {{
    applications
      |filter(app => app.status == 'pending')
      |length
  }}
)</span>

      </div>
      <div class="step-snicker flex-fill" data-tab="hired">
        <span>Hire ({{ hired|length }})</span>
      </div>
    </div>

    <!-- Main Layout -->
    <div class="row">
      <!-- LEFT COLUMN (Tabs Content) -->
      <div class="col-md-8">

        <!-- JOB TAB -->
        <div id="tab-job" class="tab-content-section">
          <div class="card shadow-sm mb-4">
            <div class="card-body">
              <p class="text-muted small mb-1">Posted on {{ serviceoffre.datePosted|date('F j, Y') }}</p>
              <h4 class="fw-bold">{{ serviceoffre.title }}</h4>
              <p class="text-muted fs-6 mb-4">{{ serviceoffre.description }}</p>

              <div class="row text-muted small mb-3">
                <div class="col"><i class="bi bi-clock"></i> Duration: {{ serviceoffre.duration }}</div>
                <div class="col"><i class="bi bi-person-badge"></i> Experience: {{ serviceoffre.ExperienceLevel }}</div>
                <div class="col"><i class="bi bi-wallet2"></i> Budget: {{ serviceoffre.price|format_currency('USD') }}</div>
              </div>

              {% if serviceoffre.skills %}
                {% for skill in serviceoffre.skills|split(',') %}
                  <span class="badge bg-light border text-dark me-1 mb-1">{{ skill|trim }}</span>
                {% endfor %}
              {% endif %}
            </div>
          </div>
        </div>

        <!-- PROPOSALS TAB -->
        <div id="tab-proposals" class="tab-content-section d-none">
          <div class="card shadow-sm mb-4">
            <div class="card-body">
              <h5 class="fw-bold mb-4">Review Proposals</h5>

              {% if applications is empty %}
                <div class="text-center py-5">
                  <img src="{{ asset('images/noproposals.svg') }}" alt="No proposals" style="max-width: 300px;">
                  <p class="text-muted mt-3 fs-5">No proposals yet!</p>
                </div>
              {% else %}
                {% for app in applications %}
                  {% if app.status == 'pending' %}
                    {% include 'application_service/_card.html.twig' with { app: app, serviceoffre: serviceoffre } %}
                  {% endif %}
                {% endfor %}
              {% endif %}
            </div>
          </div>
        </div>

        <!-- HIRED TAB -->
        <div id="tab-hired" class="tab-content-section d-none">
          <div class="card shadow-sm mb-4">
            <div class="card-body">
              <h5 class="fw-bold mb-4">Hired</h5>

              {% if hired is empty %}
                <div class="text-center py-5">
                  <img src="{{ asset('images/nohire.svg') }}" alt="No hires" style="max-width: 300px;">
                  <p class="text-muted mt-3 fs-5">You don't have any hires yet.</p>
                </div>
              {% else %}
                <ul class="list-group">
                  {% for hire in hired %}
                    {% include 'application_service/_hired.html.twig' with { hire: hire } %}
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT SIDEBAR -->
      <div class="col-md-4">
        <!-- Manage Section -->
        <div class="card shadow-sm mb-3">
          <div class="card-body">
            <h6 class="fw-bold mb-3">Manage</h6>
            <ul class="list-unstyled mb-0">
              <li class="mb-2 d-flex align-items-center text-brown">
                <i class="bi bi-pencil me-2"></i>
                <a href="{{ path('app_serviceoffre_edit', { idService: serviceoffre.idService }) }}" class="text-decoration-none text-brown fw-medium">Edit posting</a>
              </li>
              <li class="mb-2 d-flex align-items-center text-brown">
                <i class="bi bi-eye me-2"></i>
                <a href="{{ path('app_serviceoffre_show', { idService: serviceoffre.idService }) }}" class="text-decoration-none text-brown fw-medium">View posting</a>
              </li>
              <li class="mb-2 d-flex align-items-center text-brown">
                <i class="bi bi-calendar-plus me-2"></i>
                <a href="#" class="text-decoration-none text-brown fw-medium">Reuse posting</a>
              </li>
              <li class="mb-2 d-flex align-items-center text-brown">
                <i class="bi bi-lock me-2"></i>
                <a href="#" class="text-decoration-none text-brown fw-medium">Make private</a>
              </li>
              <li class="d-flex align-items-center text-brown">
                <i class="bi bi-trash me-2"></i>
                <form method="post" action="{{ path('app_serviceoffre_delete', { idService: serviceoffre.idService }) }}" onsubmit="return confirm('Are you sure you want to delete this service?');" class="d-inline m-0 p-0">
                  <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ serviceoffre.idService) }}">
                  <button type="submit" class="btn btn-link p-0 text-decoration-none text-brown fw-medium">Remove posting</button>
                </form>
              </li>
            </ul>
          </div>
        </div>

        <!-- Client Info -->
        <div class="card shadow-sm">
          <div class="card-body">
            <h6 class="fw-bold mb-2">About the Client</h6>
            <p class="text-muted small mb-1">📍 Tunisia</p>
            <p class="text-muted small mb-1">🕒 {{ "now"|date("g:i A") }}</p>
            <p class="text-muted small mb-0">🛡 Verified User (mock)</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- JavaScript for Tabs -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const steps = document.querySelectorAll('.step-snicker');
    const tabs = document.querySelectorAll('.tab-content-section');

    steps.forEach(step => {
      step.addEventListener('click', () => {
        steps.forEach(s => s.classList.remove('active'));
        step.classList.add('active');

        const targetId = 'tab-' + step.dataset.tab;
        tabs.forEach(tab => tab.classList.add('d-none'));
        document.getElementById(targetId).classList.remove('d-none');
      });
    });
  });
</script>

<!-- Styles -->
<style>
.card {
  background-color: #F0F1F2;
  border: none;
}

.badge {
  font-size: 0.75rem;
  padding: 6px 12px;
  border-radius: 50px;
}

.snickers-progress-bar {
  border: 1px solid #F0F1F2;
  background: #fff;
  height: 60px;
}

.step-snicker {
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  font-size: 15px;
  color: #6f4f1f;
  cursor: pointer;
  position: relative;
  transition: background 0.3s ease;
  border-right: 1px solid #e5e5e5;
}

.step-snicker:last-child {
  border-right: none;
}

.step-snicker.active {
  background-color: #6f4f1f;
  color: white;
  position: relative;
}

.step-snicker.active::after {
  content: '';
  position: absolute;
  right: -15px;
  top: 50%;
  transform: translateY(-50%);
  border-left: 15px solid #6f4f1f;
  border-top: 15px solid transparent;
  border-bottom: 15px solid transparent;
}

.text-brown {
  color: #6f4f1f !important;
}

.text-brown:hover {
  text-decoration: underline;
}

.fw-medium {
  font-weight: 500;
}

.proposal-card {
  transition: 0.3s ease;
  border: 1px solid #F0F1F2;
  background-color: #fff;
}

.proposal-card:hover {
  transform: scale(1.01);
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.05);
}

.btn-outline-success,
.btn-outline-danger {
  border-radius: 30px;
  font-size: 0.85rem;
  padding: 4px 12px;
  font-weight: 500;
}
</style>
{% endblock %}
{% block javascripts %}
  {{ parent() }}
  <script src="https://js.stripe.com/v3/"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const stripe = Stripe('{{ stripe_public_key }}'); // Pass this from controller

      document.querySelectorAll('.start-payment-btn').forEach(button => {
        button.addEventListener('click', function () {
          const serviceId = this.getAttribute('data-service-id');

          fetch(`/create-checkout-session/${serviceId}`)
            .then(res => res.json())
            .then(data => {
              if (data.id) {
                stripe.redirectToCheckout({ sessionId: data.id });
              } else {
                alert("Failed to initiate payment session.");
              }
            })
            .catch(err => {
              console.error("Stripe session error:", err);
              alert("An error occurred during payment.");
            });
        });
      });
    });
  </script>
{% endblock %}
