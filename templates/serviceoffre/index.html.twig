    <!-- Top Search Bar -->
  <div class="col-md-6">
  <div class="position-relative enhanced-search-container">
    <img src="{{ asset('uploads/users/logo.png.png') }}" alt="Search Logo" class="search-icon">
    <input type="text" class="form-control enhanced-search-input ps-5" id="searchInput" placeholder="Search services…" />
  </div>
</div>

<div class="currency-converter-box p-3 bg-white rounded shadow-sm" style="max-width: 430px;">
  
    <h2>Currency Converter</h2>
    <div class="input-group">
      <select id="currencySelector" class="form-select">
        {% for code, name in currencies %}
          <option value="{{ code }}">{{ name }} ({{ code }})</option>
        {% endfor %}
      </select>
      <button type="button" class="btn btn-primary" onclick="convertCurrency()">Convert</button>
    </div>

    <div id="conversionResult" class="mt-3">
  
      <p><strong>Converted:</strong> <span id="convertedPrice">Select a currency</span></p>
    </div>
  
</div>



    <div class="row">
<!-- Sidebar Filters -->
<div class="col-md-4 sidebar-filters px-4 py-4 rounded shadow-sm" style="background-color: #ffffff;">
  
  <!-- Client Tools Section -->
  <div class="sidebar d-flex flex-column py-4">
  <ul class="nav flex-column">
    <li class="nav-item mb-2">
      <a href="{{ path('app_serviceoffre_dashboard') }}" class="nav-link sidebar-link {% if app.request.pathinfo starts with path('app_serviceoffre_dashboard') %}active{% endif %}">
  <i class="bi bi-speedometer2"></i>
  <span>Dashboard</span>
</a>

<a href="{{ path('stripe_payment_history') }}" class="nav-link sidebar-link {% if app.request.pathinfo starts with path('stripe_payment_history') %}active{% endif %}">
  <i class="bi bi-credit-card-2-front"></i>
  <span>Payment History</span>
</a>

<a href="{{ path('calendar_page') }}" class="nav-link sidebar-link {% if app.request.pathinfo starts with path('calendar_page') %}active{% endif %}">
  <i class="bi bi-calendar3"></i>
  <span>Manage Calendar</span>
</a>

<a href="#" class="nav-link sidebar-link">
  <i class="bi bi-pencil-square"></i>
  <span>Task Tracker</span>
</a>

    </li>
  </ul>
</div>



  <!-- Find Your Service -->
  <h5 class="mb-4 fw-bold text-brown"><i class="bi bi-search me-2"></i> Find Your Ideal Service</h5>

  <div class="mb-4">
    <label class="form-label">Field</label>
    <select id="filterField" class="form-select">
      <option value="">All Fields</option>
      {% for field in fields %}
        <option value="{{ field }}">{{ field }}</option>
      {% endfor %}
    </select>
  </div>

  <div class="mb-4">
    <label class="form-label">Skills</label>
    <select id="filterSkills" class="form-select">
      <option value="">All Categories</option>
      {% for skill in skills %}
        <option value="{{ skill }}">{{ skill }}</option>
      {% endfor %}
    </select>
  </div>

  <div class="mb-4">
    <label class="form-label">Duration</label>
    {% for option in ['less than 1 month', '1 to 3 months', '3 to 6 months', 'more than 6 months'] %}
      <div class="form-check">
        <input class="form-check-input" type="checkbox" name="duration[]" value="{{ option }}" id="duration_{{ loop.index }}">
        <label class="form-check-label" for="duration_{{ loop.index }}">{{ option }}</label>
      </div>
    {% endfor %}
  </div>

  <div>
    <label class="form-label">Price</label>
    {% for option in ['Less than $100', '$100 to $500', '$500 to $1K', '$1K+'] %}
      <div class="form-check">
        <input class="form-check-input" type="checkbox" name="price[]" value="{{ option }}" id="price_{{ loop.index }}">
        <label class="form-check-label" for="price_{{ loop.index }}">{{ option }}</label>
      </div>
    {% endfor %}
  </div>

</div>

      <!-- Service Listings -->
      <div class="col-md-9 px-5">
      
        <div class="d-flex justify-content-between align-items-center mb-3">

          <div class="dropdown">
            <button class="btn dropdown-toggle text-dark fw-bold fs-4 border-0 bg-transparent shadow-none"
                    type="button" id="listingDropdown" data-bs-toggle="dropdown" aria-expanded="false">
              {% if app.request.query.get('my_jobs') %}
                My Services Only
              {% else %}
                Service Listings
              {% endif %}
            </button>
            <ul class="dropdown-menu" aria-labelledby="listingDropdown">
              <li><a class="dropdown-item" href="{{ path('app_serviceoffre_index') }}">All Services</a></li>
              <li><a class="dropdown-item" href="{{ path('app_serviceoffre_index', { 'my_jobs': 1 }) }}">My Services Only</a></li>
            </ul>
          </div>

          <select id="sortSelect" class="form-select w-auto" style="max-width: 200px;">
            <option value="oldest">Sort by: Oldest</option>
            <option value="newest">Sort by: Newest</option>
            <option value="relevance">Sort by: Relevance</option>
          </select>
        </div>

        <div id="serviceList" class="row gy-4">
          {% for service in serviceoffres %}
            {% include 'serviceoffre/_card.html.twig' with { service: service, sessionUser: sessionUser } %}
          {% else %}
            <div class="col-12 text-center text-muted">
              <p>No service offers found.</p>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>

