<!-- Drawer container -->
<div id="serviceDrawer" class="service-drawer position-fixed top-0 end-0 bg-white shadow"
     style="width: 50%; height: 100vh; z-index: 1050; transform: translateX(100%); transition: transform 0.3s ease-out;">
  <div class="d-flex justify-content-between align-items-center border-bottom p-4">
    <h5 class="m-0 fw-bold">Service Details</h5>
    <button class="btn btn-sm btn-close" onclick="closeDrawer()"></button>
  </div>
  <div id="drawerContent" class="p-4" style="overflow-y: auto; height: calc(100% - 60px);"></div>
</div>

<!-- Overlay for the drawer -->
<div id="drawerOverlay" class="position-fixed top-0 start-0 w-100 h-100 bg-dark"
     style="opacity: 0; z-index: 1040; pointer-events: none; transition: opacity 0.3s ease;"></div>

<script>
  function openDrawer(id) {
    const drawer = document.getElementById('serviceDrawer');
    const overlay = document.getElementById('drawerOverlay');
    const content = document.getElementById('drawerContent');

    overlay.style.pointerEvents = 'auto';
    overlay.style.opacity = '0.5';

    fetch(`/serviceoffre/${id}/drawer`, {
      headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(response => response.text())
    .then(html => {
      content.innerHTML = html;
      drawer.style.transform = 'translateX(0)';
      document.body.style.overflow = 'hidden';
      drawer.style.display = 'block';
    })
    .catch(error => {
      console.error('Erreur de chargement du drawer :', error);
      content.innerHTML = `<div class="alert alert-danger">Erreur lors du chargement des détails.</div>`;
    });
  }

  function closeDrawer() {
    const drawer = document.getElementById('serviceDrawer');
    const overlay = document.getElementById('drawerOverlay');
    
    drawer.style.transform = 'translateX(100%)';
    overlay.style.opacity = '0';
    overlay.style.pointerEvents = 'none';
    document.body.style.overflow = '';

    setTimeout(() => {
      document.getElementById('drawerContent').innerHTML = '';
    }, 300);
  }

  document.getElementById('drawerOverlay')?.addEventListener('click', closeDrawer);
</script>

 <script>
document.addEventListener('DOMContentLoaded', function() {
    // Check if all required elements exist
    const filterField = document.getElementById('filterField');
    const filterSkills = document.getElementById('filterSkills');
    const searchInput = document.getElementById('searchInput');
    const sortSelect = document.getElementById('sortSelect');
    const serviceList = document.getElementById('serviceList');

    if (!filterField || !filterSkills || !searchInput || !sortSelect || !serviceList) {
        console.error('One or more required elements are missing from the DOM');
        return;
    }

    const applyFilters = () => {
        const params = new URLSearchParams();
        
        // Add filters only if they have values
        if (filterField.value) params.append('field', filterField.value);
        if (filterSkills.value) params.append('skills', filterSkills.value);
        if (searchInput.value) params.append('search', searchInput.value);
        if (sortSelect.value) params.append('sort', sortSelect.value);

        // Add array parameters
        document.querySelectorAll('input[name="duration[]"]:checked').forEach(cb => {
            params.append('durations[]', cb.value);
        });

        document.querySelectorAll('input[name="price[]"]:checked').forEach(cb => {
            params.append('prices[]', cb.value);
        });

        console.log('Fetching with params:', params.toString());

        fetch("{{ path('app_serviceoffre_filter') }}?" + params.toString(), {
            headers: { 
                'X-Requested-With': 'XMLHttpRequest',
                'Accept': 'application/json'
            }
        })
        .then(response => {
            if (!response.ok) {
                return response.json().then(err => { throw new Error(err.error || 'Network error'); });
            }
            return response.text();
        })
        .then(html => {
            serviceList.innerHTML = html;
        })
        .catch(error => {
            console.error('Error:', error);
            serviceList.innerHTML = `
                <div class="alert alert-danger">
                    Error: ${error.message}
                </div>
            `;
        });
    };

    // Set up event listeners
    [filterField, filterSkills, searchInput, sortSelect].forEach(el => {
        el.addEventListener('change', applyFilters);
    });

    document.querySelectorAll('input[name="duration[]"], input[name="price[]"]').forEach(el => {
        el.addEventListener('change', applyFilters);
    });

    // Debounce search input
    let searchDebounce;
    searchInput.addEventListener('input', () => {
        clearTimeout(searchDebounce);
        searchDebounce = setTimeout(applyFilters, 300);
    });
});


</script>

