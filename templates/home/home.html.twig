</section><!-- Contact Section -->
<section class="contact-section py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="section-title text-center mb-5">
                    <h2 class="section-title">CONTACT</h2>
                    <p class="section-subtitle">always at your service</p>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-5">
                <div class="card team-card h-100">
                    <div class="card-body">
                        <div class="mb-4 d-flex align-items-start">
                            <div class="me-3 mt-1">
                                <i class="bi bi-geo-alt-fill text-brown" style="font-size: 1.5rem;"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold text-brown">Address</h5>
                                <p class="mb-0">Esprit, Chotrana II, Ariana, Tunisia</p>
                            </div>
                        </div>
                        
                        <div class="mb-4 d-flex align-items-start">
                            <div class="me-3 mt-1">
                                <i class="bi bi-telephone-fill text-brown" style="font-size: 1.5rem;"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold text-brown">Call Us</h5>
                                <p class="mb-0">+216 26603127</p>
                            </div>
                        </div>
                        
                        <div class="mb-4 d-flex align-items-start">
                            <div class="me-3 mt-1">
                                <i class="bi bi-envelope-fill text-brown" style="font-size: 1.5rem;"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold text-brown">Email Us</h5>
                                <p class="mb-0">pathfinder-support@gmail.com</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-7">
                <div class="card team-card h-100">
                    <div class="card-body">
                        <form id="feedbackForm" action="{{ path('feedback_submit') }}" method="POST">
                            <div class="mb-3">
                                <label for="name" class="form-label fw-bold text-brown">Your Name</label>
                                <input type="text" class="form-control" id="name" name="name" required>
                            </div>

                            <div class="mb-3">
                                <label for="subject" class="form-label fw-bold text-brown">Subject</label>
                                <input type="text" class="form-control" id="subject" name="subject" required>
                            </div>

                            <div class="mb-3">
                                <label for="message" class="form-label fw-bold text-brown">Message</label>
                                <textarea class="form-control" id="message" name="message" rows="5" required></textarea>
                            </div>

                            <button type="submit" class="btn btn-brown">
                                <i class="bi bi-send-fill me-2"></i>Send Message
                            </button>
                        </form>

                        {# Modal outside the form #}
                        <div class="modal fade" id="thankYouModal" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title text-brown">Thank You!</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <p>Thank you for your feedback! We appreciate your input.</p>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-brown" data-bs-dismiss="modal">Close</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        {# Keep the script at the end of the card body #}
                        <script>
                            document.getElementById('feedbackForm').addEventListener('submit', function(e) {
    e.preventDefault();
    
    const formData = new FormData(this);
    
    fetch(this.action, {
        method: 'POST',
        body: formData
    })
    .then(response => {
        if (!response.ok) {
            throw new Error('Network response was not ok');
        }
        return response.json();
    })
    .then(data => {
        if (data.success) {
            // Show the modal
            const modal = new bootstrap.Modal(document.getElementById('thankYouModal'));
            modal.show();
            
            // Reset the form
            this.reset();
        } else {
            alert(data.message || 'There was an error submitting your feedback. Please try again.');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('Thank you for your feedback!');
    });
});
                        </script>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .team-section {
        background-color: #f8f9fa;
    }
    .section-title {
        font-size: 2.5rem;
        font-weight: 700;
        color: #3B261D;
    }
    .section-subtitle {
        font-size: 1.2rem;
        color: #6c757d;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }
    .team-card {
        border: none;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        transition: all 0.3s ease;
    }
    .team-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 30px rgba(59, 38, 29, 0.2);
    }
    .team-img {
        width: 150px;
        height: 150px;
        object-fit: cover;
        border: 5px solid rgba(59, 38, 29, 0.1);
        transition: all 0.3s ease;
    }
    .team-card:hover .team-img {
        border-color: rgba(255, 215, 0, 0.3);
    }
    .social-links i {
        font-size: 1.2rem;
        transition: all 0.3s ease;
    }
    .social-links a:hover i {
        color: #FFD700 !important;
        transform: scale(1.2);

    }

     .contact-section {
        background-color: #f8f9fa;
    }
    .text-brown {
        color: #3B261D;
    }
    .btn-brown {
        background-color: #3B261D;
        color: white;
        border: none;
        padding: 10px 25px;
        transition: all 0.3s ease;
    }
    .btn-brown:hover {
        background-color: #5a3e2e;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(59, 38, 29, 0.2);
    }
    .form-control:focus {
        border-color: #3B261D;
        box-shadow: 0 0 0 0.25rem rgba(59, 38, 29, 0.25);
    }
</style>
