{% extends 'base.html.twig' %}

{% block title %}Applicationservice{% endblock %}

{% block body %}
    <h1>Applicationservice</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id_app</th>
                <td>{{ applicationservice.idApp }}</td>
            </tr>
            <tr>
                <th>Price_offre</th>
                <td>{{ applicationservice.priceOffre }}</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>{{ applicationservice.status }}</td>
            </tr>
            <tr>
                <th>Rating</th>
                <td>{{ applicationservice.rating ? 'Yes' : 'No' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_application_service_index') }}">back to list</a>

    <a href="{{ path('app_application_service_edit', {'id_app': applicationservice.id_app}) }}">edit</a>

    {{ include('application_service/_delete_form.html.twig') }}
{% endblock %}
