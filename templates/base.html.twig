<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}Pathfinder{% endblock %}</title>
   <link rel="icon" type="image/png" href="{{ asset('uploads/users/logo.png.png') }}">


  {{ encore_entry_link_tags('app') }}
  {% block styles %}{% endblock %}

  <style>
    html, body {
      height: 100%;
      margin: 0;
    }

    body {
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }

    #main-content {
      flex: 1;
    }

    .toast-success {
      position: fixed;
      top: 20px;
      right: 20px;
      background-color: #d1fae5;
      color: #065f46;
      padding: 15px 20px;
      border-radius: 8px;
      box-shadow: 0 0 15px rgba(0,0,0,0.1);
      z-index: 2000;
      animation: fadeIn 0.4s ease-in-out;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(-10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .application-modal-wrapper {
      position: fixed;
      top: 0;
      left: 0;
      z-index: 1055;
      width: 100%;
      height: 100%;
      background: rgba(0,0,0,0.5);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
    }

    .application-modal-box {
      background: #fff;
      width: 100%;
      max-width: 650px;
      border-radius: 12px;
      padding: 2rem;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
      position: relative;
      font-family: 'Segoe UI', sans-serif;
    }

    .btn-purple {
      background-color: #6f4f1f;
      color: #fff;
      border: none;
      padding: 12px 24px;
      border-radius: 8px;
      font-weight: 600;
      font-size: 0.95rem;
      transition: background-color 0.3s ease;
    }

    .btn-purple:hover {
      background-color: #5a3d1a;
    }

    .close-btn {
      position: absolute;
      right: 20px;
      top: 20px;
      font-size: 1.25rem;
      border: none;
      background: transparent;
      color: #999;
      cursor: pointer;
    }
  </style>



</head>

<body>
  {% include "includes/navbar.html.twig" %}

  <div id="main-content">
    {% block body %}{% endblock %}
  </div>

  {% include "includes/footer.html.twig" %}

  <!-- Bootstrap Modal Placeholder -->
  <div class="modal fade" id="applyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content rounded shadow-sm border-0" style="background-color: #F5EDE1;">
        <div id="applyModalContent">
          
        </div>
      </div>
    </div>
  </div>

  {{ encore_entry_script_tags('app') }}
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.5.1/dist/confetti.browser.min.js"></script>

  {% block javascripts %}{% endblock %}

  <script>
  function closeCustomModal() {
    const modal = document.querySelector('.application-modal-wrapper');
    if (modal) modal.remove();
  }

  function showToastSuccess(message) {
    const toast = document.createElement('div');
    toast.classList.add('toast-success');
    toast.innerText = message;
    document.body.appendChild(toast);

    setTimeout(() => {
      toast.remove();
    }, 4000);
  }

  document.addEventListener('submit', function (e) {
    if (e.target && e.target.id === 'applicationForm') {
      e.preventDefault();

      const form = e.target;
      const spinner = document.getElementById('applySpinner');
      const button = document.getElementById('submitApplicationBtn');

      if (spinner) spinner.classList.remove('d-none');
      if (button) button.setAttribute('disabled', 'true');

      fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        credentials: 'same-origin',
        headers: {
          'X-Requested-With': 'XMLHttpRequest'
        }
      })
      .then(async res => {
        const contentType = res.headers.get('content-type');

        // Handle JSON response
        if (res.ok && contentType && contentType.includes('application/json')) {
          const data = await res.json();
          if (data.success) {
            closeCustomModal();
            confetti();
            showToastSuccess('🎉 Application submitted successfully!');
          } else {
            throw new Error('Application submission failed');
          }
        }
        // Handle HTML (form re-rendered with errors)
        else {
          const html = await res.text();
          document.getElementById('applyModalContent').innerHTML = html;
        }
      })
      .catch((error) => {
        console.error('Submission error:', error);
        form.insertAdjacentHTML('beforeend', `
          <div class="alert alert-danger mt-3">
            ⚠️ Something went wrong. Please try again.
          </div>
        `);
      })
      .finally(() => {
        if (spinner) spinner.classList.add('d-none');
        if (button) button.removeAttribute('disabled');
      });
    }
  });

  // Optional: Character counters for maxLength inputs
  document.addEventListener('DOMContentLoaded', () => {
    const fields = document.querySelectorAll('input[maxlength], textarea[maxlength]');

    fields.forEach(field => {
      const maxLength = parseInt(field.getAttribute('maxlength'));
      if (!maxLength) return;

      const counter = document.createElement('small');
      counter.className = 'character-counter text-muted';
      counter.style.display = 'block';
      counter.style.marginTop = '0.5rem';

      field.parentNode.insertBefore(counter, field.nextSibling);

      const updateCounter = () => {
        const currentLength = field.value.length;
        counter.textContent = `${currentLength} / ${maxLength}`;
        counter.style.color = currentLength > maxLength ? 'red' : '#6c757d';
        field.setCustomValidity(currentLength > maxLength ? 'Character limit exceeded' : '');
      };

      updateCounter();
      field.addEventListener('input', updateCounter);
    });
  });
</script>

  
</body>
</html>
