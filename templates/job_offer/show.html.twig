{% extends 'base.html.twig' %}

{% block title %}
	{{ job_offer.title }}
	-
	{{ job_offer.user.name }}
{% endblock %}

{% block body %}
	<div class="container my-4">
		<div
			class="row">
			<!-- Main Content -->
			<div
				class="col-lg-8">
				<!-- Job Header -->
				<div class="card mb-4 shadow-sm">
					<div class="card-body">
						<div class="d-flex justify-content-between align-items-start mb-3">
							<div>
								<h1 class="h2 mb-2">{{ job_offer.title }}</h1>
								<div class="d-flex align-items-center gap-2 mb-2">
									<span class="badge bg-primary">{{ job_offer.type }}</span>
									<span class="badge bg-secondary">{{ job_offer.field }}</span>
								</div>
							</div>
							<div>
								<span class="badge bg-light text-dark border">
									<i class="bi bi-people-fill text-primary me-1"></i>
									{{ job_offer.getNumberOfSpots }}
									position(s)
								</span>
							</div>
						</div>

						<div class="d-flex align-items-center flex-wrap gap-2 mb-3">
							<a href="#" class="text-decoration-none">
								<div class="d-flex align-items-center">
									<img src="{{ asset(job_offer.user.image ?: 'images/default-company.png') }}" class="rounded-circle me-2" width="40" alt="{{ job_offer.user.name }} logo">
									<span class="fw-bold">{{ job_offer.user.name }}</span>
								</div>
							</a>
							<span class="text-muted">{{ job_offer.address }}</span>
						</div>

						<!-- Owner Actions -->
						{% if current_user.id_user == job_offer.user.id_user %}
							<div class="d-flex gap-2 mb-3">
    <a href="{{ path('app_job_offer_edit', {'id_offer': job_offer.getIdOffer()}) }}" class="btn btn-sm btn-outline-primary">
        <i class="bi bi-pencil"></i>
        Edit Job
    </a>
    <form method="post" action="{{ path('app_job_offer_delete', {'id_offer': job_offer.getIdOffer()}) }}" onsubmit="return confirm('Are you sure you want to delete this job offer?');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ job_offer.getIdOffer()) }}">
        <button type="submit" class="btn btn-sm btn-outline-danger">
            <i class="bi bi-trash"></i>
            Delete Job
        </button>
    </form>

                                {% if job_offer.getSkillTests|length > 0 %}
                                    <a href="{{ path('app_skilltest_show', {'id': job_offer.getSkillTests[0].id}) }}" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-eye"></i>
                                        View Skill Test
                                    </a>
                                {% else %}
                                    <a href="{{ path('app_skilltest_new', {'jobOfferId': job_offer.idOffer}) }}" class="btn btn-sm btn-outline-success">
                                        <i class="bi bi-plus-circle"></i>
                                        Create Skill Test
                                    </a>
                                {% endif %}


                            </div>

						{% endif %}

						<div class="d-flex flex-wrap gap-2">
							<span class="badge bg-light text-dark border">
								<i class="bi bi-calendar text-primary me-1"></i>
								Posted
								{{ job_offer.getDatePosted|date('M d, Y') }}
							</span>
							<span class="badge bg-light text-dark border">
								<i class="bi bi-mortarboard text-primary me-1"></i>
								{{ job_offer.getRequiredEducation }}
							</span>
							<span class="badge bg-light text-dark border">
								<i class="bi bi-briefcase text-primary me-1"></i>
								{{ job_offer.getRequiredExperience }}
							</span>
							<span class="badge bg-light text-dark border">
								<i class="bi bi-pin-map-fill text-primary me-1"></i>
								{{ job_offer.getAddress }}
							</span>
						</div>
					</div>
				</div>

				<!-- Job Details -->
				<div class="card mb-4 shadow-sm">
					<div class="card-header bg-light">
						<h3 class="h5 mb-0">
							<i class="bi bi-file-text text-primary me-2"></i>Job Description</h3>
					</div>
					<div class="card-body">
						{{ job_offer.description|nl2br }}
					</div>
				</div>

				<!-- Requirements -->
				<div class="card mb-4 shadow-sm">
					<div class="card-header bg-light">
						<h3 class="h5 mb-0">
							<i class="bi bi-list-check text-primary me-2"></i>Requirements</h3>
					</div>
					<div class="card-body">
						<div class="row">
							<div class="col-md-6">
								<h4 class="h6">
									<i class="bi bi-mortarboard text-primary me-2"></i>Education</h4>
								<p>{{ job_offer.getRequiredEducation }}</p>

								<h4 class="h6 mt-3">
									<i class="bi bi-briefcase text-primary me-2"></i>Experience</h4>
								<p>{{ job_offer.getRequiredExperience }}</p>
							</div>
							<div class="col-md-6">
								<h4 class="h6">
									<i class="bi bi-tools text-primary me-2"></i>Skills</h4>
								<div class="d-flex flex-wrap gap-2">
									{% for skill in job_offer.skills|split(',') %}
										{% if skill|trim %}
											<span class="badge bg-light text-dark border">
												<i class="bi bi-check-circle text-primary me-1"></i>
												{{ skill|trim }}
											</span>
										{% endif %}
									{% endfor %}
								</div>
							</div>
						</div>
					</div>
				</div>

				{% if current_user.id_user == job_offer.user.id_user %}
					<!-- Applications List for Company -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h3 class="h5 mb-0"><i class="bi bi-people text-primary me-2"></i>Applications ({{ job_offer.applications|length }})</h3>
        
        <!-- Add this dropdown for quick filtering -->
        <div class="dropdown">
            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" id="filterDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-funnel"></i> Filter
            </button>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="filterDropdown">
                <li><h6 class="dropdown-header">Status</h6></li>
                <li>
                    <a class="dropdown-item d-flex justify-content-between" href="#" data-filter="all">
                        All Applications
                        <span class="badge bg-secondary rounded-pill">{{ job_offer.applications|length }}</span>
                    </a>
                </li>
                <li>
                    <a class="dropdown-item d-flex justify-content-between" href="#" data-filter="Pending">
                        Pending
                        <span class="badge bg-warning rounded-pill">{{ job_offer.applications|filter(app => app.status == 'Pending')|length }}</span>
                    </a>
                </li>
                <li>
                    <a class="dropdown-item d-flex justify-content-between" href="#" data-filter="Accepted">
                        Accepted
                        <span class="badge bg-success rounded-pill">{{ job_offer.applications|filter(app => app.status == 'Accepted')|length }}</span>
                    </a>
                </li>
                <li>
                    <a class="dropdown-item d-flex justify-content-between" href="#" data-filter="Rejected">
                        Rejected
                        <span class="badge bg-danger rounded-pill">{{ job_offer.applications|filter(app => app.status == 'Rejected')|length }}</span>
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a class="dropdown-item d-flex justify-content-between" href="#" data-filter="incomplete">
                        In Progress
                        <span class="badge bg-secondary rounded-pill">{{ job_offer.applications|filter(app => 'Applying-' in app.status)|length }}</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
    
    <div class="card-body">
        {% if job_offer.applications is empty %}
            <div class="alert alert-info mb-0">No applications yet</div>
        {% else %}
            <!-- Add search input -->
            <div class="mb-3">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" id="applicationSearch" placeholder="Search applicants...">
                    <button class="btn btn-outline-secondary" type="button" id="clearSearch">
                        <i class="bi bi-x"></i>
                    </button>
                </div>
            </div>
            
            <!-- Wrap applications in a container for filtering -->
            <div id="applicationsContainer">
                <div class="list-group list-group-flush">
                    {% for application in job_offer.applications %}
                        <div class="list-group-item application-item" 
                             data-status="{{ application.status }}" 
                             data-name="{{ application.user.name|lower }}">
                            <!-- Your existing application item content -->
                            <div class="d-flex align-items-start gap-3 mb-2">
                                <img src="{{ application.user.image }}" 
                                     class="rounded-circle border" 
                                     width="50" 
                                     height="50"
                                     style="object-fit: cover;"
                                     alt="{{ application.user.name }} profile picture">
                                
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h5 class="h6 mb-0">{{ application.user.name }}</h5>
                                            <small class="text-muted">Applied {{ application.dateApplication|date('M d, Y') }}</small>
                                        </div>
                                        <span class="badge rounded-pill 
                                            {% if application.status == 'Pending' %}bg-warning
                                            {% elseif application.status == 'Accepted' %}bg-success
                                            {% else %}bg-danger{% endif %}">
                                            {{ application.status }}
                                        </span>
                                    </div>
                                    
                                
                                </div>
                            </div>
                            
                            <div class="d-flex justify-content-between align-items-center gap-2 mt-2">
    <div class="d-flex gap-2">
        <button class="btn btn-sm btn-outline-primary" 
                data-bs-toggle="modal" 
                data-bs-target="#applicationModal-{{ application.application_id }}">
            <i class="bi bi-eye"></i> View Details
        </button>
        {% if application.cv %}
    <button class="btn btn-sm btn-outline-primary" 
            data-bs-toggle="modal" 
            data-bs-target="#cvModal-{{ application.application_id }}">
        <i class="bi bi-file-earmark-person"></i> View CV
    </button>
    {% include 'application_job/_cvModal.html.twig' with {'application': application} %}
{% endif %}
    </div>
    
    {% if application.status == 'Pending' %}
    <div class="btn-group ms-auto">
        <form action="{{ path('app_application_job_accept', {'id': application.application_id}) }}" method="post">
            <button type="submit" class="btn btn-sm btn-outline-success me-1">Accept</button>
        </form>
        <form action="{{ path('app_application_job_reject', {'id': application.application_id}) }}" method="post">
            <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
        </form>
    </div>
    {% endif %}
</div>
                        </div>
                        {% include 'application_job/_applicationModal.html.twig' with {'application': application} %}
                    {% endfor %}
                </div>
            </div>
        {% endif %}
    </div>
</div>

				{% elseif current_user.role == 2 %}
					<!-- Application Process for Regular Users -->
					<div class="card shadow-sm">
						<div class="card-header bg-light">
							<h3 class="h5 mb-0">
								<i class="bi bi-send-check text-primary me-2"></i>Application Process</h3>
						</div>
						<div class="card-body">
							<div class="steps">
								<div class="step {% if has_applied[job_offer.getIdOffer()] is defined and 'Applying-' in has_applied[job_offer.getIdOffer()].status and has_applied[job_offer.getIdOffer()].status|split('-')[1] >= 1 %}completed{% endif %}">
									<div class="step-number">1</div>
									<div class="step-content">
										<h5 class="h6 mb-1">Create/Select CV</h5>
										<p class="small text-muted mb-0">Upload a new CV or select an existing one</p>
									</div>
								</div>

								<div class="step {% if has_applied[job_offer.getIdOffer()] is defined and 'Applying-' in has_applied[job_offer.getIdOffer()].status and has_applied[job_offer.getIdOffer()].status|split('-')[1] >= 2 %}completed{% endif %}">
									<div class="step-number">2</div>
									<div class="step-content">
										<h5 class="h6 mb-1">Cover Letter</h5>
										<p class="small text-muted mb-0">Write or upload your cover letter</p>
									</div>
								</div>

								<div class="step {% if has_applied[job_offer.getIdOffer()] is defined and 'Applying-' in has_applied[job_offer.getIdOffer()].status and has_applied[job_offer.getIdOffer()].status|split('-')[1] >= 3 %}completed{% endif %}">
									<div class="step-number">3</div>
									<div class="step-content">
										<h5 class="h6 mb-1">Skill Test</h5>
										<p class="small text-muted mb-0">Complete the required skill assessment</p>
									</div>
								</div>

								<div class="step {% if has_applied[job_offer.getIdOffer()] is defined and 'Applying-' in has_applied[job_offer.getIdOffer()].status and has_applied[job_offer.getIdOffer()].status|split('-')[1] >= 4 %}completed{% endif %}">
									<div class="step-number">4</div>
									<div class="step-content">
										<h5 class="h6 mb-1">Confirm Application</h5>
										<p class="small text-muted mb-0">Review and submit your application</p>
									</div>
								</div>
							</div>

							<div class="mt-4">
								{% if has_applied[job_offer.getIdOffer()] is defined %}
									{% set application = has_applied[job_offer.getIdOffer()] %}

									{% if 'Applying-' in application.status %}
										<a href="{{ path('app_application_job_new', {'job_offer_id': job_offer.getIdOffer()}) }}" class="btn btn-primary btn-lg w-100">
											<i class="bi bi-pencil-square"></i>
											Continue Application (Step
											{{ application.status|split('-')[1] }}/4)
										</a>
									{% elseif application.status == 'Pending' %}
										<button class="btn btn-outline-primary btn-lg w-100" data-bs-toggle="modal" data-bs-target="#applicationModal-{{ application.application_id }}">
											<i class="bi bi-eye"></i>
											View Application
										</button>
									{% elseif application.status == 'Accepted'%}
										<button class="btn btn-outline-secondary btn-lg w-100" disabled>
											<i class="bi bi-check-circle"></i>
											{{ application.status }}
										</button>
									{% else %}
										<button class="btn btn-outline-secondary btn-lg w-100" disabled>
											<i class="bi bi-x-circle"></i>
											{{ application.status }}
										</button>
									{% endif %}
								{% else %}
									<a href="{{ path('app_application_job_new', {'job_offer_id': job_offer.getIdOffer()}) }}" class="btn btn-primary btn-lg w-100">
										<i class="bi bi-send-check"></i>
										Start Application
