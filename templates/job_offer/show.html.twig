					</div>
				</div>
			</div>
		</div>
	</div>

	<style>
		.steps {
			display: flex;
			flex-direction: column;
			gap: 1.5rem;
		}
		.step {
			display: flex;
			gap: 1rem;
			position: relative;
		}
		.step:not(:last-child):after {
			content: '';
			position: absolute;
			left: 1.25rem;
			top: 2.5rem;
			bottom: -1.5rem;
			width: 2px;
			background-color: #e9ecef;
		}
		.step.completed:not(:last-child):after {
			background-color: var(--bs-secondary);
		}
		.step-number {
			width: 2.5rem;
			height: 2.5rem;
			border-radius: 50%;
			background-color: #e9ecef;
			display: flex;
			align-items: center;
			justify-content: center;
			font-weight: bold;
			flex-shrink: 0;
			z-index: 1;
		}
		.step.completed .step-number {
			background-color: var(--bs-secondary);
			color: white;
		}
		.step-content {
			padding-top: 0.5rem;
		}
	</style>
{% endblock %}
{% block javascripts %}
  

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Filter by status
    const filterLinks = document.querySelectorAll('[data-filter]');
    filterLinks.forEach(link => {
        link.addEventListener('click', function(e) {
            e.preventDefault();
            const filterValue = this.getAttribute('data-filter');
            const applications = document.querySelectorAll('.application-item');
            
            applications.forEach(app => {
                const status = app.getAttribute('data-status');
                const show = filterValue === 'all' || 
                            (filterValue === 'incomplete' && status.includes('Applying-')) || 
                            status === filterValue;
                
                app.style.display = show ? '' : 'none';
            });
            
            // Update active state
            filterLinks.forEach(l => l.classList.remove('active'));
            this.classList.add('active');
        });
    });
    
    // Search functionality
    const searchInput = document.getElementById('applicationSearch');
    const clearSearch = document.getElementById('clearSearch');
    
    searchInput.addEventListener('input', function() {
        const searchTerm = this.value.toLowerCase();
        const applications = document.querySelectorAll('.application-item');
        
        applications.forEach(app => {
            const name = app.getAttribute('data-name');
            const matchesSearch = name.includes(searchTerm);
            
            if (searchTerm === '' || matchesSearch) {
                app.style.display = '';
            } else {
                app.style.display = 'none';
            }
        });
    });
    
    clearSearch.addEventListener('click', function() {
        searchInput.value = '';
        searchInput.dispatchEvent(new Event('input'));
    });
});
</script>


<script>
document.addEventListener('DOMContentLoaded', () => {
    // Question collection handling (existing code)
    const collectionHolder = document.querySelector('#questions-collection-wrapper');
    const addButton = document.querySelector('#add-question-btn');
    let index = collectionHolder.querySelectorAll('.question-item').length;
    const prototype = collectionHolder.dataset.prototype;

    addButton.addEventListener('click', () => {
        const newForm = prototype.replace(/__name__/g, index);
        index++;

        const parser = new DOMParser();
        const doc = parser.parseFromString('<div>' + newForm + '</div>', 'text/html');
        const wrapper = document.createElement('div');
        wrapper.classList.add('question-item');
        wrapper.innerHTML = doc.body.firstChild.innerHTML;

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'btn-remove';
        btn.textContent = 'Remove';
        btn.addEventListener('click', () => wrapper.remove());
        wrapper.appendChild(btn);

        collectionHolder.appendChild(wrapper);
    });

    
    // AJAX form submission
    const skillTestForm = document.querySelector('#createSkillTestModal form');
    if (skillTestForm) {
        skillTestForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const formData = new FormData(skillTestForm);
            // Add job offer ID to the form data
           
            
            const submitButton = skillTestForm.querySelector('button[type="submit"]');
            const originalButtonText = submitButton.innerHTML;
            
            try {
                submitButton.disabled = true;
                submitButton.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Creating...';
                
                const response = await fetch(skillTestForm.action, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });
                
                const data = await response.json();
                
                if (data.success) {
                    // Show success message
                    const toast = new bootstrap.Toast(document.getElementById('successToast'));
                    document.getElementById('toastMessage').textContent = data.message;
                    toast.show();
                    
                    // Close modal
                    const modal = bootstrap.Modal.getInstance(document.getElementById('createSkillTestModal'));
                    modal.hide();
                    
                    // Update UI
                    const createBtn = document.querySelector('[data-bs-target="#createSkillTestModal"]');
                    if (createBtn) {
                        createBtn.outerHTML = `
                            <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" 
                                    data-bs-target="#viewSkillTestModal" data-skilltest-id="${data.skillTestId}">
                                <i class="bi bi-eye"></i>
                                View Skill Test
                            </button>
                        `;
                    }
                } else {
                    // Show validation errors in a more user-friendly way
                    let errorMessages = "Please fix the following errors:\n";
                    data.errors.forEach(error => {
                        errorMessages += `• ${error}\n`;
                    });
                    alert(errorMessages);
                }
            } catch (error) {
                console.error('Error:', error);
                alert('An error occurred while creating the skill test');
            } finally {
                submitButton.disabled = false;
                submitButton.innerHTML = originalButtonText;
            }
        });
    }
});
</script>
{% endblock %}