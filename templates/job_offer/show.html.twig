								{% endif %}
							</div>
						</div>
					</div>
				{% endif %}
			</div>

			<!-- Sidebar -->
			<div
				class="col-lg-4">
				<!-- Company Profile -->
				<div class="card mb-4 shadow-sm">
					<div class="card-header bg-light">
						<h3 class="h5 mb-0">
							<i class="bi bi-building text-primary me-2"></i>About the Company</h3>
					</div>
					<div class="card-body text-center">
						<img src="{{ asset(job_offer.user.image ?: 'images/default-company.png') }}" class="rounded-circle border border-3 border-primary mb-3 object-fit-cover" width="120" height="120" style="object-fit: cover;" alt="{{ job_offer.user.name }} logo">
						<h4>{{ job_offer.user.name }}</h4>
						<p class="text-muted">{{ job_offer.field }}</p>

						<div class="d-grid gap-2">
							<button class="btn btn-outline-primary">
								<i class="bi bi-eye"></i>
								View Profile
							</button>
						</div>
					</div>
				</div>

				<!-- Job Actions -->
				<div class="card shadow-sm">
					<div class="card-header bg-light">
						<h3 class="h5 mb-0">
							<i class="bi bi-share text-primary me-2"></i>Share This Job</h3>
					</div>
					<div class="card-body">
						<div class="btn-group w-100" role="group">
							<button type="button" class="btn btn-outline-primary">
								<i class="bi bi-linkedin"></i>
							</button>
							<button type="button" class="btn btn-outline-primary">
								<i class="bi bi-twitter"></i>
							</button>
							<button type="button" class="btn btn-outline-primary">
								<i class="bi bi-envelope"></i>
							</button>
							<button type="button" class="btn btn-outline-primary">
								<i class="bi bi-link-45deg"></i>
							</button>
						</div>
						<button class="btn btn-outline-secondary w-100 mt-2">
							<i class="bi bi-printer"></i>
							Print Job
