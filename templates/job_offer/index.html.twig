	{% block javascripts %}
		<script>
document.addEventListener('DOMContentLoaded', function () {
    // Initialize everything on first load
    initializePage();
    
    function initializePage() {
        setupScrollButtons();
        setupSearchAndFilters();
        setupLocationHandlers();
    }

    function setupScrollButtons() {
        // Remove existing listeners first to prevent duplicates
        document.querySelectorAll('.scroll-left').forEach(btn => {
            btn.replaceWith(btn.cloneNode(true));
        });
        document.querySelectorAll('.scroll-right').forEach(btn => {
            btn.replaceWith(btn.cloneNode(true));
        });

        // Attach new listeners
        document.querySelectorAll('.scroll-left').forEach(button => {
            button.addEventListener('click', function() {
                const scroller = this.closest('.position-relative').querySelector('.recommended-scroller');
                if (scroller) {
                    const cardWidth = scroller.querySelector('.flex-shrink-0')?.offsetWidth + 15 || 315; // 15px gap
                    scroller.scrollBy({ left: -cardWidth, behavior: 'smooth' });
                }
            });
        });

        document.querySelectorAll('.scroll-right').forEach(button => {
            button.addEventListener('click', function() {
                const scroller = this.closest('.position-relative').querySelector('.recommended-scroller');
                if (scroller) {
                    const cardWidth = scroller.querySelector('.flex-shrink-0')?.offsetWidth + 15 || 315; // 15px gap
                    scroller.scrollBy({ left: cardWidth, behavior: 'smooth' });
                }
            });
        });
    }

    function setupSearchAndFilters() {
        const searchInput = document.getElementById('searchInput');
        const searchButton = document.getElementById('searchButton');
        const container = document.getElementById('job-offers-container');
        const filtersForm = document.getElementById('filtersForm');
        
        let searchTimer;
        
        searchButton?.addEventListener('click', loadJobOffers);
        searchInput?.addEventListener('input', function() {
            clearTimeout(searchTimer);
            searchTimer = setTimeout(loadJobOffers, 500);
        });
        
        filtersForm?.addEventListener('submit', function(e) {
            e.preventDefault();
            loadJobOffers();
        });
    }

    function setupLocationHandlers() {
    const locationInput = document.getElementById('locationInput');
    const locationSearchBtn = document.getElementById('locationSearchBtn');
    const locationOptions = document.getElementById('locationOptions');
    const clearLocationBtn = document.getElementById('clearLocationBtn');
    const distanceSlider = document.getElementById('distanceSlider');
    const distanceValue = document.getElementById('distanceValue');
    const distanceSliderContainer = document.getElementById('distanceSliderContainer');
    
    if (distanceSlider) {
        distanceSlider.addEventListener('input', function() {
            if (distanceValue) distanceValue.textContent = this.value;
        });

        // Add change listener for the slider
        distanceSlider.addEventListener('change', function() {
            // Only trigger search if "nearby" is selected and location has value
            const nearbySelected = document.getElementById('nearbyLocation')?.checked;
            if (nearbySelected && locationInput.value.trim()) {
                loadJobOffers();
            }
        });
    }

    // Handle location search button click
    locationSearchBtn?.addEventListener('click', function() {
        if (locationInput.value.trim()) {
            // Show the location options instead of immediately searching
            locationOptions?.classList.remove('d-none');
            
            // Uncheck both radio buttons when options first appear
            document.getElementById('exactLocation').checked = false;
            document.getElementById('nearbyLocation').checked = false;
            
            // Hide distance slider initially
            distanceSliderContainer?.classList.add('d-none');
        }
    });

    // Handle radio button changes
    document.querySelectorAll('input[name="locationType"]').forEach(radio => {
        radio.addEventListener('change', function() {
            if (this.value === 'nearby') {
                distanceSliderContainer?.classList.remove('d-none');
                // If switching to nearby and location has value, trigger search
                if (locationInput.value.trim()) {
                    loadJobOffers();
                }
            } else {
                distanceSliderContainer?.classList.add('d-none');
                // If switching to exact and location has value, trigger search
                if (locationInput.value.trim()) {
                    loadJobOffers();
                }
            }
        });
    });

    clearLocationBtn?.addEventListener('click', function() {
        locationInput.value = '';
        locationOptions?.classList.add('d-none');
        // Uncheck both radios when clearing
        document.getElementById('exactLocation').checked = false;
        document.getElementById('nearbyLocation').checked = false;
        loadJobOffers();
    });
}

    async function loadJobOffers() {
        const container = document.getElementById('job-offers-container');
        if (!container) return;

        const previousContent = container.innerHTML;
        container.innerHTML = `
            <div class="text-center py-4">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>`;

        try {
            const params = new URLSearchParams();
            params.append('ajax', '1');

            // Add search term if exists
            const searchInput = document.getElementById('searchInput');
            if (searchInput?.value.trim()) {
                params.append('search', searchInput.value.trim());
            }

            // Add all active filters
            document.querySelectorAll('input[name="types[]"]:checked').forEach(checkbox => {
                params.append('types[]', checkbox.value);
            });
            document.querySelectorAll('input[name="fields[]"]:checked').forEach(checkbox => {
                params.append('fields[]', checkbox.value);
            });
            document.querySelectorAll('input[name="education[]"]:checked').forEach(checkbox => {
                params.append('education[]', checkbox.value);
            });

            // Add location filter if selected
            const locationInput = document.getElementById('locationInput');
            if (locationInput?.value.trim()) {
                const locationType = document.querySelector('input[name="locationType"]:checked')?.value || 'exact';
                params.append('location', locationInput.value.trim());
                params.append('locationType', locationType);

                if (locationType === 'nearby') {
                    const distanceSlider = document.getElementById('distanceSlider');
                    params.append('distance', distanceSlider?.value || 50);
                }
            }

            const response = await fetch(`{{ path('app_job_offer_index') }}?${params.toString()}`, {
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });

            if (!response.ok) throw new Error('Network response was not ok');

            const html = await response.text();
            const tempDiv = document.createElement('div');
            tempDiv.innerHTML = html;
            const jobContainer = tempDiv.querySelector('#job-offers-container');

            if (!jobContainer || jobContainer.innerHTML.includes('No job offers found')) {
                container.innerHTML = `
                    <div class="card border-0 shadow-sm">
                        <div class="card-body text-center py-4">
                            <i class="bi bi-file-earmark-text fs-1 text-muted mb-2"></i>
                            <h3 class="h5">No job offers found</h3>
                            <p class="text-muted mb-3">No results found</p>
                        </div>
                    </div>`;
            } else {
                container.innerHTML = jobContainer.innerHTML;
                // Reinitialize scroll buttons after content loads
                setupScrollButtons();
            }
        } catch (error) {
            console.error('Error:', error);
            container.innerHTML = previousContent;
            alert('Error loading job offers. Please try again.');
        }
    }
});


		</script>
	{% endblock %}
