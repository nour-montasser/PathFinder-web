{% extends 'base.html.twig' %}

{% block title %}Job Recommendations{% endblock %}

{% block body %}
<section class="section">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mx-auto">
                <div class="card">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                        <h1 class="h4 mb-0">
                            <i class="bi bi-lightbulb me-2"></i>Job Recommendations
                        </h1>
                        <a href="{{ path('app_job_offer_index') }}" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-arrow-left me-1"></i> Back to Job Listings
                        </a>
                    </div>
                    <div class="card-body">
                        {% if error is defined %}
                            <div class="alert alert-warning">
                                <i class="bi bi-exclamation-triangle me-2"></i>{{ error }}
                                <div class="mt-3">
                                    <a href="{{ path('app_cv_new') }}" class="btn btn-primary btn-sm">
                                        <i class="bi bi-file-earmark-plus me-1"></i> Create a CV
                                    </a>
                                </div>
                            </div>
                        {% elseif suggestions is empty %}
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle me-2"></i>No job recommendations found based on your profile.
                                <div class="mt-3">
                                    <p>Try enhancing your CV with more skills to get better matches.</p>
                                </div>
                            </div>
                        {% else %}
                            <div class="mb-4">
                                <div class="alert alert-info">
                                    <i class="bi bi-info-circle me-2"></i>These jobs are recommended based on your CV and application history.
                                </div>
                            </div>
                            
                            <div class="row">
                                {% for suggestion in suggestions %}
                                    <div class="col-md-6 mb-4">
                                        <div class="card h-100 border border-2 border-success">
                                            <div class="card-header bg-light-success d-flex justify-content-between align-items-center">
                                                <div class="d-flex align-items-center">
                                                    <img src="{{ asset(suggestion.job.user.image ?: 'images/default-profile.png') }}" 
                                                         class="rounded-circle me-3" width="40" height="40" alt="Company logo">
                                                    <div>
                                                        <h6 class="card-title mb-0">{{ suggestion.job.title }}</h6>
                                                        <small class="text-muted">{{ suggestion.job.user.name }}</small>
                                                    </div>
                                                </div>
                                                <span class="badge bg-success">{{ suggestion.confidence|round }}% Match</span>
                                            </div>
                                            <div class="card-body">
                                                <p class="text-success small mb-2">
                                                    <i class="bi bi-check-circle me-1"></i>
                                                    {{ suggestion.reason }}
                                                </p>
                                                <div class="d-flex justify-content-between small mb-2">
                                                    <span>Skills Match:</span>
                                                    <span>{{ (suggestion.skillsMatch * 100)|round }}%</span>
                                                </div>
                                                <div class="progress mb-2" style="height: 6px;">
                                                    <div class="progress-bar bg-success" style="width: {{ suggestion.skillsMatch * 100 }}%"></div>
                                                </div>
                                                
                                                <div class="mb-3">
                                                    <small class="text-muted">
                                                        <i class="bi bi-geo-alt me-1"></i>{{ suggestion.job.address }}
                                                    </small>
                                                </div>
                                                
                                                <div class="skills mb-3">
                                                    <h6 class="small text-muted mb-1">
                                                        <i class="bi bi-tools me-1"></i>
                                                        Skills:</h6>
                                                    <div class="d-flex flex-wrap gap-1">
                                                        {% for skill in suggestion.job.skills|split(',') %}
                                                            {% if skill|trim %}
                                                                <span class="badge bg-light text-dark border">
                                                                    {{ skill|trim }}
                                                                </span>
                                                            {% endif %}
                                                        {% endfor %}
                                                    </div>
                                                </div>
                                                
                                                <a href="{{ path('app_job_offer_show', {'id_offer': suggestion.job.idOffer}) }}" 
                                                   class="btn btn-sm btn-success w-100">
                                                    <i class="bi bi-eye me-1"></i> View Job
                                                </a>
                                                
                                                {% if suggestion.job.numberOfSpots > 0 %}
                                                    <a href="{{ path('app_application_job_new', {'job_offer_id': suggestion.job.idOffer}) }}" 
                                                       class="btn btn-sm btn-outline-success w-100 mt-2">
                                                        <i class="bi bi-send me-1"></i> Apply Now
                                                    </a>
                                                {% else %}
                                                    <button class="btn btn-sm btn-outline-secondary w-100 mt-2" disabled>
                                                        <i class="bi bi-x-circle me-1"></i> No Spots Available
                                                    </button>
                                                {% endif %}
                                            </div>
                                            <div class="card-footer bg-light">
                                                <small class="text-muted">
                                                    <i class="bi bi-calendar me-1"></i>
                                                    Posted: {{ suggestion.job.datePosted|date('M d, Y') }}
                                                </small>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .bg-light-success {
        background-color: rgba(40, 167, 69, 0.15) !important;
    }
    .border-success {
        border-color: #28a745 !important;
    }

    /* Job recommendation specific styles */
.bg-light-success {
    background-color: rgba(40, 167, 69, 0.15) !important;
}

.border-success {
    border-color: #28a745 !important;
}

.progress {
    background-color: #e9ecef;
    border-radius: .25rem;
    height: 6px;
}

.progress-bar.bg-success {
    background-color: #28a745 !important;
}

/* Card transition effects */
.card {
    transition: transform 0.2s, box-shadow 0.2s;
}

.card:hover {
    transform: translateY(-3px);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
}
</style>
{% endblock %}