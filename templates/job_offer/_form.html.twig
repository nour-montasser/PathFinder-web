    <script>
   document.addEventListener('DOMContentLoaded', function() {
    console.log("Script loaded!");
    
    const form = document.querySelector('form[name="job_offer"]');
    const countrySelect = document.querySelector('select[name$="[country]"]');
    const cityInput = document.querySelector('[data-city-target="input"]');
    const cityDisplay = document.querySelector('[data-city-target="display"]');
    const addressInput = document.querySelector('input[name$="[address]"]');

    if (!form || !countrySelect || !cityInput || !cityDisplay || !addressInput) {
        console.error("Missing required elements");
        return;
    }

    // Function to update address
    function updateAddress() {
        const countryName = countrySelect.options[countrySelect.selectedIndex].text;
        const city = cityInput.value;
        if (countryName && city) {
            addressInput.value = `${countryName}, ${city}`;
            cityDisplay.value = city; // Update display field
            console.log("Address updated:", addressInput.value);
        }
    }

    // Function to load cities and show dropdown
    async function loadCities(countryCode) {
        if (!countryCode) {
            // Clear city selection
            cityInput.value = '';
            cityDisplay.value = '';
            return;
        }

        try {
            // Show loading state
            cityDisplay.value = 'Loading cities...';
            
            const response = await fetch(`/jobOffer/get-cities/${countryCode}`);
            if (!response.ok) throw new Error('Failed to fetch cities');

            const cities = await response.json();
            
            // Create a temporary dropdown
            const cityDropdown = document.createElement('select');
            cityDropdown.className = 'form-select';
            cityDropdown.innerHTML = '<option value="">Select a city</option>';
            
            cities.forEach(city => {
                const option = document.createElement('option');
                option.value = city;
                option.textContent = city;
                cityDropdown.appendChild(option);
            });
            
            // Replace display field with dropdown
            cityDisplay.replaceWith(cityDropdown);
            
            // Handle city selection
            cityDropdown.addEventListener('change', function() {
                cityInput.value = this.value;
                updateAddress();
                
                // Replace dropdown back with display field
                cityDisplay.value = this.value;
                this.replaceWith(cityDisplay);
            });
            
        } catch (error) {
            console.error('Error:', error);
            cityDisplay.value = 'Error loading cities';
        }
    }

    // Event listeners
    countrySelect.addEventListener('change', function() {
        console.log("Country changed to:", this.value);
        loadCities(this.value);
    });

    // Form submission handler
    form.addEventListener('submit', function(e) {
        if (!countrySelect.value || !cityInput.value) {
            e.preventDefault();
            alert('Please select both country and city');
            return false;
        }
        return true;
    });

    // Initialize if country is selected
    if (countrySelect.value) {
        loadCities(countrySelect.value);
    }
});
    </script>
    {% endblock %}
