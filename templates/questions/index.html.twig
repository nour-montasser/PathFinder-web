{% extends 'base.html.twig' %}

{% block title %}Questions index{% endblock %}

{% block body %}
    <h1>Questions index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id_question</th>
                <th>Question</th>
                <th>Responses</th>
                <th>Correct_response</th>
                <th>Score</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for question in questions %}
            <tr>
                <td>{{ question.idQuestion }}</td>
                <td>{{ question.question }}</td>
                <td>{{ question.responses }}</td>
                <td>{{ question.correctResponse }}</td>
                <td>{{ question.score }}</td>
                <td>
                    <a href="{{ path('app_questions_show', {'id_question': question.id_question}) }}">show</a>
                    <a href="{{ path('app_questions_edit', {'id_question': question.id_question}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_questions_new') }}">Create new</a>
{% endblock %}
