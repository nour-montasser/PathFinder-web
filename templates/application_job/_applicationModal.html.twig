{# templates/application_job/_applicationModal.html.twig #}
{% if application is defined %}
	{% set current_user = current_user ?? app.user %}
	<div class="modal fade" id="applicationModal-{{ application.application_id }}" tabindex="-1" aria-labelledby="applicationModalLabel-{{ application.application_id }}" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
			<div class="modal-content">
				<div class="modal-header bg-primary text-white">
					<div class="d-flex align-items-center">
						{% if application.jobOffer and application.jobOffer.user.image %}
							<img src="{{ application.jobOffer.user.image }}" class="rounded-circle me-3" width="40" height="40" alt="Company logo">
						{% endif %}
						<div>
							<h5 class="modal-title mb-0 text-white" id="applicationModalLabel-{{ application.application_id }}">
								<i class="bi bi-file-earmark-text" style="font-size: 1.1em"></i>
								Application Details
							</h5>
							{% if application.jobOffer %}
								<small class="text-white-50">{{ application.jobOffer.user.name }}</small>
							{% endif %}
						</div>
					</div>
					<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>

				<div class="modal-body">
					<div class="row">
						{% if application.status matches '/^Applying-[1-4]$/' %}
							<div class="col-12 mb-3">
								<div class="card border-0 shadow-sm">
									<div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
										<h6 class="mb-0 fw-semibold">
											<i class="bi bi-arrow-repeat me-2 text-primary"></i>
											Application Progress
										</h6>
										<span class="badge bg-primary text-white px-2 py-1">
											Step
											{{ application.status|split('-')[1] }}
											of 4
										</span>
									</div>
									<div class="card-body py-2 px-3">
										<div class="progress" style="height: 8px">
											<div class="progress-bar bg-primary progress-bar-striped progress-bar-animated" role="progressbar" style="width: {{ (application.status|split('-')[1]/4)*100 }}%" aria-valuenow="{{ application.status|split('-')[1] }}" aria-valuemin="1" aria-valuemax="4"></div>
										</div>
										<div class="d-flex justify-content-between mt-2 small text-muted">
											<span>0%</span>
											<span>25%</span>
											<span>50%</span>
											<span>75%</span>
											<span>100%</span>
										</div>
										{% if application.status|split('-')[1] == '4' %}
											<div class="alert alert-success mt-3 mb-0 py-2 d-flex align-items-center">
												<i class="bi bi-check-circle-fill me-2"></i>
												<div>
													<strong>Ready to submit!</strong>
													<span class="d-block small">Please review and submit your application</span>
												</div>
											</div>
										{% endif %}
									</div>
								</div>
							</div>
						{% endif %}

						<!-- Left Column - Application Info -->
						<div class="col-md-6">
							<div class="card mb-4 border-0 shadow-sm">
								<div class="card-header bg-light">
									<h6 class="mb-0">
										<i class="bi bi-info-circle me-2"></i>Application Information
									</h6>
								</div>
								<div class="card-body">
									<dl class="row mb-0">
										<dt class="col-sm-5">Reference:</dt>
										<dd class="col-sm-7">REF-{{ application.application_id|slice(0, 8) }}</dd>
										<dt class="col-sm-5">Submitted:</dt>
										<dd class="col-sm-7">{{ application.dateApplication|date('M j, Y \\a\\t g:i A') }}</dd>
										<dt class="col-sm-5">Status:</dt>
										<dd class="col-sm-7">
											<span class="badge rounded-pill
																										                                                {% if application.status == 'Reviewing' %}bg-warning text-dark
																										                                                {% elseif application.status == 'Accepted' %}bg-success
																										                                                {% elseif application.status == 'Rejected' %}bg-danger
																										                                                {% else %}bg-secondary{% endif %}">
												{{ application.status }}
											</span>
										</dd>
										<dt class="col-sm-5">CV Used:</dt>
										<dd class="col-sm-7">
											{% if application.cv %}
												<span class="text-dark fw-semibold">{{ application.cv.title }}</span>
											{% else %}
												<em class="text-muted">You haven't submitted a CV yet.</em>
											{% endif %}
										</dd>
									</dl>
								</div>
							</div>
						</div>

						<!-- Right Column - Job Details -->
						<div class="col-md-6">
							<div class="card mb-4 border-0 shadow-sm">
								<div class="card-header bg-light">
									<h6 class="mb-0">
										<i class="bi bi-briefcase me-2"></i>Job Details
									</h6>
								</div>
								<div class="card-body">
									{% if application.jobOffer %}
										<dl class="row mb-0">
											<dt class="col-sm-4">Position:</dt>
											<dd class="col-sm-8">{{ application.jobOffer.title }}</dd>
											<dt class="col-sm-4">Company:</dt>
											<dd class="col-sm-8">{{ application.jobOffer.user.name }}</dd>
											<dt class="col-sm-4">Job Type:</dt>
											<dd class="col-sm-8">
												<span class="badge bg-primary">{{ application.jobOffer.type }}</span>
											</dd>
											<dt class="col-sm-4">Field:</dt>
											<dd class="col-sm-8">
												<span class="badge bg-secondary">{{ application.jobOffer.field }}</span>
											</dd>
										</dl>
									{% else %}
										<div class="alert alert-warning mb-0">Job offer details not available</div>
									{% endif %}
								</div>
							</div>
						</div>
					</div>

					<!-- Cover Letter Section -->
					<div class="card border-0 shadow-sm mb-3">
						<div class="card-header bg-light py-2 px-3">
							<h6 class="mb-0 fw-semibold">
								<i class="bi bi-file-earmark-text me-2"></i>Cover Letter
							</h6>
						</div>
						<div class="card-body p-3">
							{% if application.coverletter and application.coverletter.content %}
								<div
									class="border rounded p-3 bg-white" style="font-size: 0.925rem; max-height: 300px; overflow-y: auto;">
									<!-- Compact email header -->
									<div class="mb-2">
										{% if application.coverletter.subject %}
											<h5 class="mb-1">{{ application.coverletter.subject }}</h5>
										{% endif %}
										<div class="d-flex flex-wrap text-muted small gap-2">
											<div>
												<span class="fw-semibold">From:</span>
												{{ current_user.fullName ?? current_user.email }}
											</div>
											<div>
												<span class="fw-semibold">Date:</span>
												{{ application.dateApplication|date('M j, Y') }}
											</div>
											{% if application.jobOffer %}
												<div>
													<span class="fw-semibold">To:</span>
													{{ application.jobOffer.user.name }}
												</div>
											{% endif %}
										</div>
									</div>

									<hr
									class="my-2">

									<!-- Cover letter content -->
									<div class="cover-letter-content" style="white-space: pre-wrap; line-height: 1.6;">
										{{ application.coverletter.content }}
									</div>
								</div>
							{% else %}
								<div class="alert alert-info mb-0 d-flex align-items-center p-2">
									<i class="bi bi-info-circle-fill me-2"></i>
									<div class="small">
										<strong>No cover letter submitted</strong>
									</div>
								</div>
							{% endif %}
						</div>
					</div>

				</div>

				<div class="modal-footer d-flex justify-content-between align-items-center">
				
					{% set canEditPending = false %}
					{% if application.status == 'Pending' %}
						{% set submissionTime = application.dateApplication %}
						{% set twoHoursAgo = "now"|date_modify("-2 hours") %}
						{% set canEditPending = submissionTime > twoHoursAgo %}
					{% endif %}

					{% set canEdit = (application.status matches '/^Applying-[1-4]$/') or canEditPending %}

					{% if canEdit and current_user.role == 2 %}
						<div class="d-flex">
							<form method="post" action="{{ path('app_application_job_delete', {'application_id': application.application_id}) }}" onsubmit="return confirm('Are you sure you want to delete this application?');">
								<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ application.application_id) }}">
								<button type="submit" class="btn btn-danger me-2">
									<i class="bi bi-trash"></i>
									Delete
								</button>
							</form>

							<a href="{{ path('app_application_job_edit', {'application_id': application.application_id}) }}" class="btn btn-outline-secondary me-2">
								<i class="bi bi-pencil"></i>
								Edit
							</a>
						</div>

						<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
							<i class="bi bi-x-lg"></i>
							Close
						</button>
					{% else %}
						<button type="button" class="btn btn-secondary ms-auto" data-bs-dismiss="modal">
							<i class="bi bi-x-lg"></i>
							Close
						</button>
					{% endif %}
				</div>
			</div>
		</div>
	</div>
{% endif %}


<style>
	.cover-letter-content {
		font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
		color: #222;
		line-height: 1.6;
	}
	.cover-letter-content p {
		margin-bottom: 1rem;
	}
</style>
