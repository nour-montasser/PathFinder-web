{# templates/application_job/_applicationModal.html.twig #}
{% if application is defined %}
<div class="modal fade" id="applicationModal-{{ application.application_id }}" tabindex="-1" 
     aria-labelledby="applicationModalLabel-{{ application.application_id }}" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <div class="d-flex align-items-center">
                    {% if application.jobOffer and application.jobOffer.user.image %}
                        <img src="{{  application.jobOffer.user.image }}" 
                             class="rounded-circle me-3" 
                             width="40" 
                             height="40" 
                             alt="Company logo">
                    {% endif %}
                    <div>
                        <h5 class="modal-title mb-0 text-white" id="applicationModalLabel-{{ application.application_id }}">   
                         <i class="bi bi-file-earmark-text" style="font-size: 1.1em"></i> Application Details
                        </h5>
                        {% if application.jobOffer %}
                            <small class="text-whit e-50">{{ application.jobOffer.user.name }}</small>
                        {% endif %}
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" 
                        aria-label="Close"></button>
            </div>
            
            <div class="modal-body">
                <div class="row">
                    <!-- Left Column - Application Info -->
                    <div class="col-md-6">
                        <div class="card mb-4 border-0 shadow-sm">
                            <div class="card-header bg-light">
                                <h6 class="mb-0"><i class="bi bi-info-circle me-2"></i>Application Information</h6>
                            </div>
                            <div class="card-body">
                                <dl class="row mb-0">
                                    <dt class="col-sm-5">Application ID:</dt>
                                    <dd class="col-sm-7"><code>{{ application.application_id }}</code></dd>
                                    
                                    <dt class="col-sm-5">Submitted:</dt>
                                    <dd class="col-sm-7">{{ application.dateApplication|date('M j, Y \\a\\t g:i A') }}</dd>
                                    
                                    <dt class="col-sm-5">Status:</dt>
                                    <dd class="col-sm-7">
                                        <span class="badge rounded-pill 
                                            {% if application.status == 'Pending' %}bg-warning text-dark
                                            {% elseif application.status == 'Accepted' %}bg-success
                                            {% elseif application.status == 'Rejected' %}bg-danger
                                            {% else %}bg-secondary{% endif %}">
                                            {{ application.status }}
                                        </span>
                                    </dd>
                                </dl>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column - Job Details -->
                    <div class="col-md-6">
                        <div class="card mb-4 border-0 shadow-sm">
                            <div class="card-header bg-light">
                                <h6 class="mb-0"><i class="bi bi-briefcase me-2"></i>Job Details</h6>
                            </div>
                            <div class="card-body">
                                {% if application.jobOffer %}
                                    <dl class="row mb-0">
                                        <dt class="col-sm-4">Position:</dt>
                                        <dd class="col-sm-8">{{ application.jobOffer.title }}</dd>
                                        
                                        <dt class="col-sm-4">Company:</dt>
                                        <dd class="col-sm-8">{{ application.jobOffer.user.name }}</dd>
                                        
                                        <dt class="col-sm-4">Job Type:</dt>
                                        <dd class="col-sm-8">
                                            <span class="badge bg-primary">{{ application.jobOffer.type }}</span>
                                        </dd>
                                        
                                        <dt class="col-sm-4">Field:</dt>
                                        <dd class="col-sm-8">
                                            <span class="badge bg-secondary">{{ application.jobOffer.field }}</span>
                                        </dd>
                                    </dl>
                                {% else %}
                                    <div class="alert alert-warning mb-0">Job offer details not available</div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Cover Letter Section -->
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-light">
                        <h6 class="mb-0"><i class="bi bi-file-earmark-text me-2"></i>Cover Letter</h6>
                    </div>
                    <div class="card-body">
                      
                    </div>
                </div>
            </div>
            
            <div class="modal-footer">
                {% set canEdit = true %}
                {% if application.status in ['Accepted', 'Rejected'] %}
                    {% set canEdit = false %}
                {% elseif application.status == 'Pending' and application.dateApplication < date('-2 hours') %}
                    {% set canEdit = false %}
                {% endif %}

                <form method="post" action="{{ path('app_application_job_delete', {'application_id': application.application_id}) }}" 
                      class="me-auto" onsubmit="return confirm('Are you sure you want to delete this application?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ application.application_id) }}">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Delete
                    </button>
                </form>
                
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg"></i> Close
                </button>
                
                {% if canEdit %}
                    <a href="{{ path('app_application_job_edit', {'application_id': application.application_id}) }}" 
                       class="btn btn-primary">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endif %}