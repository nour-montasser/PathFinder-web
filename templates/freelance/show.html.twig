{% extends 'base.html.twig' %}

{% block title %}Service Offers{% endblock %}

{% block body %}
<div class="container my-4">
    <h1 class="mb-4">Service Offers</h1>
    <div class="row">
        {% for service in serviceoffre %}
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h4 class="card-title">{{ service.title }}</h4>
                        <p class="card-text">
                            {{ service.description|slice(0, 150) ~ (service.description|length > 150 ? '...' : '') }}
                        </p>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item"><strong>Field:</strong> {{ service.field }}</li>
                            <li class="list-group-item"><strong>Price:</strong> {{ service.price }} USD</li>
                            <li class="list-group-item"><strong>Duration:</strong> {{ service.duration }}</li>
                            <li class="list-group-item"><strong>Status:</strong> {{ service.status }}</li>
                        </ul>
                    </div>
                    <div class="card-footer text-center">
                        <a href="{{ path('app_service_offre_show', {'id_service': service.id_service}) }}" class="btn btn-primary">
                            View Details
                        </a>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <p class="text-center">No service offers found.</p>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
