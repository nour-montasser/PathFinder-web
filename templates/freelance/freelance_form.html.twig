{% block title %}Create Service Offer{% endblock %}

{% block body %}
<section class="section">
    <div class="container">
        <div class="row">
            <!-- Left Sidebar -->
            <div class="col-lg-3 d-none d-lg-block">
                <div class="card mb-4">
                    <div class="card-body">
                        <h6 class="card-title">
                            <i class="bi bi-list-check me-2"></i>Creation Steps
                        </h6>
                        <ul class="nav flex-column creation-steps">
                            <li class="nav-item active mb-2 p-2 rounded">
                                <i class="bi bi-1-circle me-2"></i>Service Details
                            </li>
                            <li class="nav-item mb-2 p-2 rounded">
                                <i class="bi bi-2-circle me-2"></i>Requirements
                            </li>
                            <li class="nav-item mb-2 p-2 rounded">
                                <i class="bi bi-3-circle me-2"></i>Pricing & Duration
                            </li>
                            <li class="nav-item p-2 rounded">
                                <i class="bi bi-4-circle me-2"></i>Review
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-body">
                        <h6 class="card-title">
                            <i class="bi bi-lightbulb me-2"></i>Pro Tips
                        </h6>
                        <ul class="list-unstyled tips-list">
                            <li class="mb-2 p-2 rounded">
                                <i class="bi bi-check-circle text-success me-2"></i>
                                Use clear, specific service titles
                            </li>
                            <li class="mb-2 p-2 rounded">
                                <i class="bi bi-check-circle text-success me-2"></i>
                                Highlight key benefits and features
                            </li>
                            <li class="mb-2 p-2 rounded">
                                <i class="bi bi-check-circle text-success me-2"></i>
                                List your skills and experience clearly
                            </li>
                            <li class="p-2 rounded">
                                <i class="bi bi-check-circle text-success me-2"></i>
                                Include pricing and duration details
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Main Form -->
            <div class="col-lg-6">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h4 class="card-title text-white">
                            <i class="bi bi-gear me-2"></i>Create New Service Offer
                        </h4>
                    </div>
                    <div class="card-body">
                        {{ form_start(form, {'attr': {'class': 'form form-horizontal'}}) }}

                        <div class="form-group row mb-4">
                            <label class="col-form-label col-md-3">Service Title</label>
                            <div class="col-md-9">
                                {{ form_widget(form.title, {'attr': {
                                    'class': 'form-control',
                                    'placeholder': 'E.g. Professional Web Design'
                                }}) }}
                            </div>
                        </div>

                        <div class="form-group row mb-4">
                            <label class="col-form-label col-md-3">Description</label>
                            <div class="col-md-9">
                                {{ form_widget(form.description, {'attr': {
                                    'class': 'form-control',
                                    'rows': 5,
                                    'placeholder': 'Describe the service, features and benefits...'
                                }}) }}
                                <small class="form-text text-muted">Minimum 150 characters</small>
                            </div>
                        </div>

                        <div class="form-group row mb-4">
                            <label class="col-form-label col-md-3">Field</label>
                            <div class="col-md-9">
                                {{ form_widget(form.field, {'attr': {'class': 'form-select'}}) }}
                            </div>
                        </div>

                        <div class="form-group row mb-4">
                            <label class="col-form-label col-md-3">Price</label>
                            <div class="col-md-9">
                                <div class="input-group">
                                    {{ form_widget(form.price, {'attr': {
                                        'class': 'form-control',
                                        'min': 0,
                                        'step': '0.01',
                                        'placeholder': 'E.g. 199.99'
                                    }}) }}
                                    <span class="input-group-text">USD</span>
                                </div>
                            </div>
                        </div>

                        <div class="form-group row mb-4">
                            <label class="col-form-label col-md-3">Education</label>
                            <div class="col-md-9">
                                {{ form_widget(form.required_education, {'attr': {
                                    'class': 'form-control'
                                }}) }}
                            </div>
                        </div>

                        <div class="form-group row mb-4">
                            <label class="col-form-label col-md-3">Skills</label>
                            <div class="col-md-9">
                                {{ form_widget(form.skills, {'attr': {
                                    'class': 'form-control tags-input',
                                    'placeholder': 'E.g. Photoshop, Illustrator, UX Design'
                                }}) }}
                                <small class="form-text text-muted">Separate with commas</small>
                            </div>
                        </div>

                        <div class="form-group row mb-4">
                            <label class="col-form-label col-md-3">Experience Level</label>
                            <div class="col-md-9">
                                {{ form_widget(form.experience_level, {'attr': {'class': 'form-select'}}) }}
                            </div>
                        </div>

                        <div class="form-group row mb-4">
                            <label class="col-form-label col-md-3">Duration</label>
                            <div class="col-md-9">
                                {{ form_widget(form.duration, {'attr': {
                                    'class': 'form-control',
                                    'placeholder': 'E.g. 3 months'
                                }}) }}
                            </div>
                        </div>

                        <div class="form-group row mb-4">
                            <label class="col-form-label col-md-3">Status</label>
                            <div class="col-md-9">
                                {{ form_widget(form.status, {'attr': {
                                    'class': 'form-select'
                                }}) }}
                            </div>
                        </div>

                        <div class="form-group row mb-4">
                            <div class="col-md-9 offset-md-3">
                                <div class="d-flex justify-content-end gap-3">
                                    <a href="{{ path('app_service_offre_index') }}" class="btn btn-light">
                                        <i class="bi bi-x-circle me-1"></i> Cancel
                                    </a>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-save me-1"></i> Save Service Offer
                                    </button>
                                </div>
                            </div>
                        </div>

                        {{ form_end(form) }}
                    </div>
                </div>
            </div>

            <!-- Right Sidebar -->
            <div class="col-lg-3 d-none d-lg-block">
                <div class="card mb-4">
                    <div class="card-body">
                        <h6 class="card-title">
                            <i class="bi bi-files me-2"></i>Your Templates
                        </h6>
                        <div class="list-group template-list">
                            <a href="#" class="list-group-item list-group-item-action d-flex align-items-center">
                                <i class="bi bi-file-earmark-text me-2"></i>
                                Web Design
                            </a>
                            <a href="#" class="list-group-item list-group-item-action d-flex align-items-center">
                                <i class="bi bi-file-earmark-text me-2"></i>
                                Graphic Design
                            </a>
                            <a href="#" class="list-group-item list-group-item-action d-flex align-items-center">
                                <i class="bi bi-file-earmark-text me-2"></i>
                                Digital Marketing
                            </a>
                            <a href="#" class="list-group-item list-group-item-action d-flex align-items-center text-primary">
                                <i class="bi bi-plus-circle me-2"></i>
                                Create New Template
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-body">
                        <h6 class="card-title">
                            <i class="bi bi-graph-up me-2"></i>Your Stats
                        </h6>
                        <div class="stats-container">
                            <div class="stat-item d-flex justify-content-between align-items-center p-2 mb-2 rounded">
                                <span>Active Offers:</span>
                                <span class="badge bg-primary rounded-pill">8</span>
                            </div>
                            <div class="stat-item d-flex justify-content-between align-items-center p-2 mb-2 rounded">
                                <span>Avg. Response Time:</span>
                                <span class="badge bg-success rounded-pill">2 hrs</span>
                            </div>
                            <div class="stat-item d-flex justify-content-between align-items-center p-2 rounded">
                                <span>Conversion Rate:</span>
                                <span class="badge bg-info rounded-pill">25%</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">
                            <i class="bi bi-robot me-2"></i>AI Assistant
                        </h6>
                        <div class="d-grid gap-2">
                            <button class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-magic me-1"></i> Improve Description
                            </button>
                            <button class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-lightbulb me-1"></i> Suggest Skills
                            </button>
                            <button class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-currency-dollar me-1"></i> Recommend Price
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}

{% block stylesheets %}
<style>
    .creation-steps .nav-item.active {
        background-color: #e9f7fe;
        color: #0d6efd;
    }
    .tips-list li:hover {
        background-color: #f8f9fa;
    }
    .template-list a:hover {
        background-color: #f8f9fa;
    }
    .stat-item:hover {
        background-color: #f8f9fa;
    }
</style>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Initialize tags input for skills if Tagify is available
    const tagsInput = document.querySelector('.tags-input');
    if (tagsInput && typeof Tagify !== 'undefined') {
        new Tagify(tagsInput, {
            delimiters: ',',
            pattern: /^[a-zA-Z0-9\s-]+$/,
            dropdown: {
                enabled: 1,
                maxItems: 10
            }
        });
    }

    // Template click handler
    document.querySelectorAll('.template-list a').forEach(item => {
        item.addEventListener('click', function(e) {
            if (!this.querySelector('.bi-plus-circle')) {
                e.preventDefault();
                // Load template logic would go here
                console.log('Loading template: ' + this.textContent.trim());
            }
        });
    });

    // AI Assistant buttons
    document.querySelectorAll('.btn-outline-primary').forEach(btn => {
        btn.addEventListener('click', function() {
            const action = this.textContent.trim();
            console.log('AI Action: ' + action);
            // Implement AI functionality here
        });
    });
});
</script>
{% endblock %}
