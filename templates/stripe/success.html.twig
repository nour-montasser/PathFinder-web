{% extends 'base.html.twig' %}

{% block title %}Payment Successful{% endblock %}

{% block body %}
<div class="container py-5 d-flex flex-column align-items-center justify-content-center text-center">

    <img src="{{ asset('images/success.svg') }}" alt="Success" class="mb-4" style="max-width: 300px;">

    <h1 class="mb-3 text-success">✅ Payment Completed Successfully!</h1>

    <p class="lead mb-4">You are now ready to collaborate with your freelancer. Let's build something amazing!</p>

    <div class="card shadow-sm p-4 mb-5" style="width: 100%; max-width: 600px;">
        <h4 class="mb-3">Service Details:</h4>
        <ul class="list-unstyled">
            <li><strong>Service:</strong> {{ payment.application.service.title }}</li>
            <li><strong>Amount:</strong> {{ payment.amount | format_currency('USD') }}</li>
            <li><strong>Date:</strong> {{ payment.paidAt | date('F j, Y - H:i') }}</li>
            <li><strong>Stripe Session ID:</strong> {{ payment.stripeSessionId }}</li>
        </ul>

        {% if payment.receiptUrl %}
            <a href="{{ payment.receiptUrl }}" target="_blank" class="btn btn-outline-primary mt-3">
                🔗 View Stripe Receipt
            </a>
        {% endif %}
    </div>

    <a href="{{ path('app_serviceoffre_dashboard') }}" class="btn btn-success btn-lg">
        🚀 Go to Your Hires
    </a>

</div>
{% endblock %}
