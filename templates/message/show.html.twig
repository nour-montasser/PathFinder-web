{% extends 'base.html.twig' %}

{% block title %}Message{% endblock %}

{% block body %}
    <h1>Message</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id_message</th>
                <td>{{ message.idMessage }}</td>
            </tr>
            <tr>
                <th>Content</th>
                <td>{{ message.content }}</td>
            </tr>
            <tr>
                <th>Media</th>
                <td>{{ message.media }}</td>
            </tr>
            <tr>
                <th>Time_sent</th>
                <td>{{ message.timeSent ? message.timeSent|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_message_index') }}">back to list</a>

    <a href="{{ path('app_message_edit', {'id_message': message.id_message}) }}">edit</a>

    {{ include('message/_delete_form.html.twig') }}
{% endblock %}
