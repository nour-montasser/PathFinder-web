	<script>
function scrollToBottom(force = false) {
    const container = document.getElementById('messages-container');
    if (!container) return;

    // Add a small delay to ensure content is rendered
    setTimeout(() => {
        const scrollHeight = container.scrollHeight;
        const scrollTop = container.scrollTop;
        const clientHeight = container.clientHeight;
        const inputHeight = 70; // Match the height from CSS
        
        // Calculate if we're near the bottom (within 100px)
        const isAtBottom = (scrollHeight - scrollTop - inputHeight) <= (clientHeight + 100);

        if (force || isAtBottom) {
            // Scroll to bottom while accounting for the input area
            container.scrollTop = scrollHeight - clientHeight + inputHeight;
        }
    }, 100); // Increased delay for better reliability
}

// Scroll on page load
document.addEventListener('DOMContentLoaded', () =>scrollToBottom(true)
);
document.addEventListener('turbo:render', () => scrollToBottom(true));
window.addEventListener('load', () => scrollToBottom(true));
const messagesContainer = document.getElementById('messages-container');
if (messagesContainer) {
    const observer = new MutationObserver(() => scrollToBottom(true));
    observer.observe(messagesContainer, { 
        childList: true, 
        subtree: true 
    });
}
	</script>

{# Define user variables first #}
<script>
    // These variables must be defined BEFORE websocket.js loads
    const currentUserId = {{ currentUser.getId_user() }};
    const channelId = {{ selectedChannelId ?? 'null' }};
    const currentUserImage = "{{ currentUser.image ? currentUser.image : asset('build/images/faces/default-profile.png') }}";
    const currentUserName = "{{ currentUser.name }}";
</script>

{# Define user variables in a hidden element #}
<div id="current-user-data" 
     data-user-id="{{ currentUser.getId_user() }}"
     data-channel-id="{{ selectedChannelId ?? '' }}"
     data-user-image="{{ currentUser.image ? currentUser.image : asset('build/images/faces/default-profile.png') }}"
     style="display:none;"></div>

{# Single script section #}
<script>
// WebSocketClient class definition
class WebSocketClient {
    constructor(userId, channelId, userImage) {
        this.userId = userId;
        this.channelId = channelId;
        this.userImage = userImage || '/build/images/faces/default-profile.png';
        this.socket = null;
        this.messageQueue = [];
        this.connectAttempts = 0;
        this.maxConnectAttempts = 5;
        this.onlineUsers = new Set();
        this.seenMessages = new Set();
        
        this.connect();
        
        // Keepalive ping every 25 seconds
        this.keepaliveInterval = setInterval(() => {
            if (this.socket?.readyState === WebSocket.OPEN) {
                this.socket.send(JSON.stringify({ type: 'ping' }));
            }
        }, 25000);

        // Add visibility change detection
        document.addEventListener('visibilitychange', () => {
            if (document.visibilityState === 'visible' && this.channelId) {
                this.markChannelAsSeen();
            }
        });

        // Mark messages as seen when scrolling
        const messagesContainer = document.getElementById('messages-container');
        if (messagesContainer) {
            messagesContainer.addEventListener('scroll', this.handleScroll.bind(this));
        }
    }

    handleScroll() {
        const messages = document.querySelectorAll('.chat-message[data-message-id]');
        messages.forEach(message => {
            if (this.isMessageVisible(message) && 
                message.dataset.senderId !== this.userId.toString() && 
                !this.seenMessages.has(message.dataset.messageId)) {
                this.markMessageAsSeen(message.dataset.messageId);
            }
        });
    }

    isMessageVisible(element) {
        const container = document.getElementById('messages-container');
        if (!container) return false;

        const containerRect = container.getBoundingClientRect();
        const elementRect = element.getBoundingClientRect();

        return elementRect.top >= containerRect.top && 
               elementRect.bottom <= containerRect.bottom;
    }

    markMessageAsSeen(messageId) {
        if (this.seenMessages.has(messageId)) return;
        
        this.seenMessages.add(messageId);
        if (this.socket?.readyState === WebSocket.OPEN) {
            this.socket.send(JSON.stringify({
                type: 'messageSeen',
                messageId: messageId,
                channelId: this.channelId
            }));
        }
    }

    markChannelAsSeen() {
        if (this.socket?.readyState === WebSocket.OPEN) {
            this.socket.send(JSON.stringify({
                type: 'channelSeen',
                channelId: this.channelId
            }));
        }
    }

    updateMessageSeen(messageId, seenBy) {
        console.log('Updating message seen status:', messageId, 'seen by:', seenBy);
        if (seenBy === this.userId) return;
        
        const messageElement = document.querySelector(`.chat-message[data-message-id="${messageId}"]`);
        if (messageElement) {
            let seenElement = messageElement.querySelector('.seen-status');
            if (!seenElement) {
                seenElement = document.createElement('small');
                seenElement.className = 'seen-status';
                seenElement.textContent = 'Seen';
                const metaDiv = messageElement.querySelector('.message-meta .d-flex');
                if (metaDiv) {
                    metaDiv.appendChild(seenElement);
                }
            }
            seenElement.style.display = 'inline'; // Make sure it's visible
        }
    }

    updateChannelSeen(channelId, seenBy) {
        if (seenBy === this.userId) return;
        
        document.querySelectorAll(`.chat-message[data-sender-id="${this.userId}"]`).forEach(msg => {
            if (!msg.querySelector('.seen-status')) {
                const seenElement = document.createElement('small');
                seenElement.className = 'seen-status';
                seenElement.textContent = 'Seen';
                msg.querySelector('.message-meta').appendChild(seenElement);
            }
        });
    }

    flushMessageQueue() {
        while (this.messageQueue.length > 0) {
            const message = this.messageQueue.shift();
            if (this.socket?.readyState === WebSocket.OPEN) {
                this.socket.send(JSON.stringify(message));
            }
        }
    }

    connect() {
        try {
            this.socket = new WebSocket('ws://localhost:8082');
            
            this.socket.onopen = () => {
                console.log('Connected to WebSocket server');
                this.authenticate();
                if (this.channelId) {
                    this.subscribe();
                }
            };
            
            this.socket.onmessage = (event) => {
                const data = JSON.parse(event.data);
                this.handleMessage(data);
            };
            
            this.socket.onclose = () => {
                console.log('WebSocket connection closed');
                setTimeout(() => this.reconnect(), 2000);
            };
            
            this.socket.onerror = (error) => {
                console.error('WebSocket error:', error);
            };
        } catch (error) {
            console.error('WebSocket connection error:', error);
            setTimeout(() => this.reconnect(), 2000);
        }
    }

    authenticate() {
        if (this.socket?.readyState === WebSocket.OPEN) {
            this.socket.send(JSON.stringify({
                type: 'auth',
                userId: this.userId
            }));
        }
    }

    subscribe() {
        if (this.socket?.readyState === WebSocket.OPEN) {
            this.socket.send(JSON.stringify({
                type: 'subscribe',
                channelId: this.channelId,
                userId: this.userId
            }));
        }
    }

    reconnect() {
        if (this.connectAttempts < this.maxConnectAttempts) {
            this.connectAttempts++;
            console.log(`Reconnecting... Attempt ${this.connectAttempts}`);
            this.connect();
        }
    }

    sendMessage(content) {
        if (this.socket?.readyState === WebSocket.OPEN) {
            this.socket.send(JSON.stringify({
                type: 'message',
                content: content,
                channelId: this.channelId,
                userId: this.userId
            }));
        } else {
            this.messageQueue.push({
                type: 'message',
                content: content,
                channelId: this.channelId,
                userId: this.userId
            });
        }
    }

    handleMessage(data) {
        console.log('Received message:', data);
        switch (data.type) {
            case 'message':
                this.displayMessage(data);
                break;
            case 'messageSeen':
                this.updateMessageSeen(data.messageId, data.seenBy);
                break;
            case 'channelSeen':
                this.updateChannelSeen(data.channelId, data.seenBy);
                break;
            case 'userStatus':
                this.updateUserStatus(data.userId, data.isOnline);
                break;
            case 'authenticated':
                console.log('Successfully authenticated');
                break;
            case 'subscribed':
                console.log('Successfully subscribed to channel');
                break;
            case 'pong':
                break;
            default:
                console.warn('Unknown message type:', data.type);
        }
    }

    displayMessage(data) {
        const messagesContainer = document.getElementById('messages-container');
        if (!messagesContainer) return;

        const isCurrentUser = data.sender.id === this.userId;
        const messageDiv = document.createElement('div');
        messageDiv.className = `d-flex ${isCurrentUser ? 'justify-content-end' : 'justify-content-start'} mb-3`;

        messageDiv.innerHTML = `
            ${!isCurrentUser ? `
                <div class="me-3">
                    <img src="${data.sender.image || '/build/images/faces/default-profile.png'}" 
                         alt="${data.sender.name}" 
                         class="rounded-circle" 
                         style="width: 40px; height: 40px; object-fit: cover;">
                </div>
            ` : ''}

            <div class="chat-message ${isCurrentUser ? 'sent-message' : 'received-message'}"
                 data-message-id="${data.id}"
                 data-sender-id="${data.sender.id}">
                <div class="message-content">${data.content}</div>
                <div class="message-meta">
                    <div class="d-flex align-items-center">
                        <small class="message-time">${data.timeSent}</small>
                        ${isCurrentUser ? '<small class="seen-status" style="display: none;">Seen</small>' : ''}
                    </div>
                </div>
            </div>

            ${isCurrentUser ? `
                <div class="ms-3">
                    <img src="${this.userImage}" 
                         alt="You" 
                         class="rounded-circle" 
                         style="width: 40px; height: 40px; object-fit: cover;">
                </div>
            ` : ''}
        `;

        messagesContainer.querySelector('.chat-content').appendChild(messageDiv);
        scrollToBottom(true);
    }

    updateUserStatus(userId, isOnline) {
        console.log('Updating user status:', userId, isOnline);
        if (isOnline) {
            this.onlineUsers.add(userId);
        } else {
            this.onlineUsers.delete(userId);
        }

        document.querySelectorAll(`[data-user-id="${userId}"] .user-status`).forEach(indicator => {
            indicator.classList.remove('online', 'offline');
            indicator.classList.add(isOnline ? 'online' : 'offline');
            indicator.title = isOnline ? 'Online' : 'Offline';
        });

        console.log('Current online users:', Array.from(this.onlineUsers));
    }
}
</script>

<script>
    // Initialize when page loads
    document.addEventListener('DOMContentLoaded', () => {
        const userData = document.getElementById('current-user-data');
        if (!userData) {
            console.error('Current user data element not found');
            return;
        }

        const currentUserId = parseInt(userData.dataset.userId);
        const channelId = userData.dataset.channelId ? parseInt(userData.dataset.channelId) : null;
        const currentUserImage = userData.dataset.userImage;

        if (channelId && !isNaN(currentUserId)) {
            window.wsClient = new WebSocketClient(currentUserId, channelId, currentUserImage);
            
            // Mark channel as seen when loading
            setTimeout(() => {
                window.wsClient.markChannelAsSeen();
                window.wsClient.handleScroll(); // Check initial messages
            }, 1000);

            const messageForm = document.querySelector('form[name="message"]');
            if (messageForm) {
                messageForm.addEventListener('submit', (e) => {
                    e.preventDefault();
                    const input = messageForm.querySelector('input[name="message[content]"]');
                    const textarea = messageForm.querySelector('textarea[name="message[content]"]');
                    const messageInput = input || textarea;
                    
                    if (messageInput?.value.trim()) {
                        window.wsClient.sendMessage(messageInput.value.trim());
                        messageInput.value = '';
                        
                        // Also submit the form normally for fallback
                        if (window.wsClient.socket?.readyState !== WebSocket.OPEN) {
                            messageForm.submit();
                        }
                    }
                });
            }
        } else {
            console.error('Missing required user data or channel ID');
        }
    });

    // Add this to your existing script section
document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('message-search');
    const searchResults = document.getElementById('search-results');
    let searchTimeout;

    if (!searchInput || !searchResults) return;

    searchInput.addEventListener('input', (e) => {
        clearTimeout(searchTimeout);
        const query = e.target.value.trim();
        
        if (query.length < 2) {
            searchResults.style.display = 'none';
            return;
        }

        searchTimeout = setTimeout(() => {
            const currentChannelId = document.querySelector('#current-user-data').dataset.channelId;
            
            fetch(`/message/messages/search?q=${encodeURIComponent(query)}&channelId=${currentChannelId}`)
                .then(response => response.json())
                .then(data => {
                    if (data.messages && data.messages.length > 0) {
                        searchResults.innerHTML = data.messages.map(message => `
                            <div class="search-result" data-message-id="${message.id}">
                                <div class="d-flex align-items-center">
                                    <img src="${message.sender.image || '/build/images/faces/default-profile.png'}" 
                                         alt="${message.sender.name}"
                                         class="rounded-circle me-2"
                                         style="width: 24px; height: 24px; object-fit: cover;">
                                    <div>
                                        <div class="small text-truncate">${message.content}</div>
                                        <small class="text-muted">${message.timeSent}</small>
                                    </div>
                                </div>
                            </div>
                        `).join('');
                        searchResults.style.display = 'block';
                    } else {
                        searchResults.innerHTML = '<div class="p-2 text-muted">No messages found</div>';
                        searchResults.style.display = 'block';
                    }
                });
        }, 300);
    });

    // Hide search results when clicking outside
    document.addEventListener('click', (e) => {
        if (!searchResults.contains(e.target) && e.target !== searchInput) {
            searchResults.style.display = 'none';
        }
    });

    // Scroll to message when clicking search result
    searchResults.addEventListener('click', (e) => {
        const resultItem = e.target.closest('.search-result');
        if (resultItem) {
            const messageId = resultItem.dataset.messageId;
            const messageElement = document.querySelector(`.chat-message[data-message-id="${messageId}"]`);
            if (messageElement) {
                messageElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
                messageElement.classList.add('highlighted-message');
                setTimeout(() => {
                    messageElement.classList.remove('highlighted-message');
                }, 2000);
            }
            searchResults.style.display = 'none';
            searchInput.value = '';
        }
    });
});
</script>

