{% extends 'base.html.twig' %}

{% block title %}Message index
{% endblock %}

{% block body %}
	<div class="container-fluid vh-100 p-0">
		<div
			class="row g-0 h-100">
			<!-- Channels Sidebar -->
			<div class="col-md-4 h-100 d-flex flex-column border-end">
				{% include 'message/_channel_list.html.twig' %}
			</div>

			<!-- Messages Content -->
			<div class="col-md-8 d-flex flex-column h-100">
				<div class="p-3 border-bottom">
					<div class="d-flex justify-content-between align-items-center">
						<h5 class="mb-0">Messages</h5>
						<small class="text-muted">{{ messages|length }}
							messages</small>
					</div>
				</div>

				<!-- Scrollable messages area -->
				<div class="flex-grow-1 overflow-auto p-3 bg-grey">
					<div class="chat-content">
						{% for message in messages %}
							<div class="d-flex {% if message.sender.idUser == currentUser.idUser %}justify-content-end{% else %}justify-content-start{% endif %} mb-3">
								<div class="chat-message {% if message.sender.idUser == currentUser.idUser %}sent-message{% else %}received-message{% endif %}">

									{% if editingMessageId is defined and editingMessageId == message.idMessage %}
										<div class="edit-message-form mb-3">
											{{ form_start(editForm, {'attr': {'class': 'd-flex'}}) }}
											{{ form_widget(editForm.content, {'attr': {
                                            'class': 'form-control',
                                                'placeholder': 'Edit your message...'
                                                }}) }}
											<button type="submit" class="btn btn-primary ms-2">Update</button>
											{{ form_end(editForm) }}
										</div>
									{% else %}
										<div class="message-content">
											{{ message.content }}
											{% if message.media %}
												<div class="message-media mt-2">
													<img src="{{ asset('uploads/' ~ message.media) }}" alt="Media" class="img-thumbnail" style="max-width: 200px;">
												</div>
											{% endif %}
										</div>
										<div class="message-meta d-flex justify-content-between align-items-center mt-1">
											<small class="message-time">
												{{ message.timeSent ? message.timeSent|date('H:i') : '' }}
											</small>
											{% if message.sender.idUser == currentUser.idUser %}
												<div class="message-actions">
													<a href="{{ path('app_message_edit_inline', {'id_message': message.idMessage}) }}" class="text-white ms-2">
														<i class="bi bi-pencil"></i>
													</a>
													<form method="post" action="{{ path('app_message_delete', {'id_message': message.idMessage}) }}" class="d-inline" onsubmit="return confirm('Are you sure?')">
														<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ message.idMessage) }}">
														<button type="submit" class="text-white bg-transparent border-0 p-0 ms-1">
															<i class="bi bi-trash"></i>
														</button>
													</form>
												</div>
											{% endif %}
										</div>
									{% endif %}
								</div>
							</div>
						{% endfor %}


					</div>
				</div>

				<!-- New Message Form -->
				<div class="p-3 border-top bg-white" style="position: sticky; bottom: 0;">
					{{ form_start(form, {'attr': {'class': 'd-flex'}}) }}

					{# Let Symfony handle channel and sender #}
					{% if form.channel is defined %}
						{{ form_widget(form.channel, {'attr': {'class': 'd-none'}}) }}
					{% endif %}
					{% if form.sender is defined %}
						{{ form_widget(form.sender, {'attr': {'class': 'd-none'}}) }}
					{% endif %}

					<div class="input-group">
						{{ form_widget(form.content, {'attr': {
							'class': 'form-control',
							'placeholder': 'Type your message...'
						}}) }}

						

						<button type="submit" class="btn btn-primary">Send</button>
					</div>

					{{ form_end(form) }}
				</div>
			</div>
		</div>
	</div>
{% endblock %}

{% block styles %}
	<style>
		body {
			overflow: hidden;
		}
		.bg-grey {
			background-color: #f5f5f5;
		}
		.chat {
			border-radius: 5px;
		}
		.chat.chat-left .chat-message {
			background: #5a8dee;
			float: left;
			color: #fff;
		}
		.chat .chat-message {
			text-align: left;
			float: right;
			margin: 0.2rem 0 1.8rem 0.2rem;
			color: #525361;
			background-color: #fafbfb;
			box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
			padding: 0.75rem 1rem;
			position: relative;
			max-width: calc(100% - 5rem);
			clear: both;
			word-break: break-word;
			border-radius: 0.267rem;
			cursor: pointer;
		}
		.chat.chat-left .message-time,
		.chat.chat-left .message-actions a,
		.chat.chat-left .message-actions button {
			color: rgba(255, 255, 255, 0.7) !important;
		}
		.message-actions {
			opacity: 0;
			transition: opacity 0.2s;
		}
		.chat-message:hover .message-actions {
			opacity: 1;
		}
		.message-time-full {
			position: absolute;
			bottom: -1.5rem;
			left: 0;
			background: rgba(0, 0, 0, 0.7);
			color: white;
			padding: 0.2rem 0.5rem;
			border-radius: 0.25rem;
			z-index: 10;
		}
		.chat-left .message-time-full {
			left: auto;
			right: 0;
		}
		.list-group-item {
			border-left: 0;
			border-right: 0;
			padding: 0.75rem 1.25rem;
		}
		.edit-message-form {
			padding: 1rem;
			background: #f8f9fa;
			box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
		}
		#user-select {
			cursor: pointer;
		}

		.list-group-item.active {
			background-color: #5a8dee;
			border-color: #5a8dee;
		}

		.list-group-item-action:hover {
			background-color: #f5f5f5;
		}
		/* Add to your existing styles */
		.list-group-item {
			display: flex;
			align-items: center;
			padding: 0.75rem 1.25rem;
		}

		.list-group-item a {
			flex-grow: 1;
		}

		.btn-danger {
			opacity: 0;
			transition: opacity 0.2s;
		}

		.list-group-item:hover .btn-danger {
			opacity: 1;
		}

		/* Message bubbles */
		.chat-left .chat-message {
			background: #f1f1f1; /* Grey for received messages */
			color: #333;
			float: left;
			margin-right: auto;
		}

		.chat-right .chat-message {
			background: #5a8dee; /* Blue for sent messages */
			color: white;
			float: right;
			margin-left: auto;
		}

		/* Consistent message bubble styling */
		.chat-message {
			max-width: 70%;
			padding: 0.75rem 1rem;
			border-radius: 0.75rem;
			margin-bottom: 0.5rem;
			position: relative;
			clear: both;
		}

		/* Message bubbles */
		.chat-message {
			max-width: 70%;
			padding: 0.75rem 1rem;
			border-radius: 1rem;
			position: relative;
			word-wrap: break-word;
		}

		.sent-message {
			background: #5a8dee; /* Blue for sent messages */
			color: white;
			border-bottom-right-radius: 0;
		}

		.received-message {
			background: #f1f1f1; /* Grey for received messages */
			color: #333;
			border-bottom-left-radius: 0;
		}

		/* Message meta information */
		.message-meta {
			font-size: 0.75rem;
		}

		.sent-message .message-time {
			color: rgba(255, 255, 255, 0.7);
		}

		.received-message .message-time {
			color: rgba(0, 0, 0, 0.5);
		}

		/* Action buttons */
		.message-actions {
			opacity: 0;
			transition: opacity 0.2s;
		}

		.chat-message:hover .message-actions {
			opacity: 1;
		}
	</style>
{% endblock %}
