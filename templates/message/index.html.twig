{% extends 'base.html.twig' %}

{% block title %}Message index
{% endblock %}

{% block body %}
	<div class="container-fluid vh-100 p-0">
		<div
			class="row g-0 h-100">
			<!-- Channels Sidebar -->
			<div class="col-md-4 h-100 d-flex flex-column border-end">
				{% include 'message/_channel_list.html.twig' %}
			</div>

			<!-- Messages Content -->
			<div class="col-md-8 d-flex flex-column h-100 position-relative">
    <div class="p-3 border-bottom">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Messages</h5>
            <div class="d-flex align-items-center">
                <div class="position-relative me-3">
                    <input type="text" 
                           id="message-search" 
                           class="form-control form-control-sm" 
                           placeholder="Search messages...">
                    <div id="search-results" 
                         class="position-absolute start-0 w-100 mt-1 bg-white shadow-sm rounded-2" 
                         style="display: none; max-height: 300px; overflow-y: auto; z-index: 1000;">
                    </div>
                </div>
                <small class="text-muted">{{ messages|length }} messages</small>
            </div>
        </div>
    </div>

				<!-- Scrollable messages area -->
				<div id="messages-container" class="flex-grow-1 overflow-auto p-3 bg-grey">
    <div class="chat-content">
        {% for message in messages %}
            <div class="d-flex {% if message.sender.getId_user == currentUser.getId_user %}justify-content-end{% else %}justify-content-start{% endif %} mb-3">
                {% if message.sender.getId_user != currentUser.getId_user %}
                    <!-- Profile picture for received messages -->
                    <div class="me-3">
                        {% if message.sender.image %}
                            <img src="{{ message.sender.image }}" alt="{{ message.sender.name }}" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;">
                        {% else %}
                            <img src="{{ asset('build/images/faces/default-profile.png') }}" alt="Default profile" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;">
                        {% endif %}
                    </div>
                {% endif %}

                <div class="chat-message {% if message.sender.getId_user == currentUser.getId_user %}sent-message{% else %}received-message{% endif %}"
     data-message-id="{{ message.idMessage }}"
     data-sender-id="{{ message.sender.getId_user }}">
    <div class="message-content">
        {{ message.content }}
    </div>
    <div class="message-meta">
        <div class="d-flex align-items-center justify-content-between w-100">
            <div class="d-flex align-items-center">
                <small class="message-time">{{ message.timeSent ? message.timeSent|date('H:i') : '' }}</small>
                {% if message.sender.getId_user == currentUser.getId_user %}
                    <small class="seen-status ms-2">•&nbsp;Seen</small>
                {% endif %}
            </div>
            {% if message.sender.getId_user == currentUser.getId_user %}
                <div class="message-actions">
                    <a href="{{ path('app_message_edit_inline', {'id_message': message.idMessage}) }}" 
                       class="text-decoration-none me-2">
                        <i class="bi bi-pencil"></i>
                    </a>
                    <form action="{{ path('app_message_delete', {'id_message': message.idMessage}) }}" 
                          method="post" 
                          class="d-inline"
                          onsubmit="return confirm('Are you sure you want to delete this message?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ message.idMessage) }}">
                        <button type="submit" class="btn btn-link p-0 text-danger">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                </div>
            {% endif %}
        </div>
    </div>
</div>

                {% if message.sender.getId_user == currentUser.getId_user %}
                    <!-- Profile picture for sent messages (optional) -->
                    <div class="ms-3">
                        {% if currentUser.image %}
                            <img src="{{ currentUser.image }}" alt="{{ currentUser.name }}" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;">
                        {% else %}
                            <img src="{{ asset('build/images/faces/default-profile.png') }}" alt="Default profile" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;">
                        {% endif %}
                    </div>
                {% endif %}
            </div>
        {% endfor %}
    </div>
</div>

				<!-- New Message Form -->
				<!-- New Message Form -->
<div class="border-top bg-white">
    {{ form_start(form) }}
    <div class="input-group">
        {{ form_widget(form.content, {
            'attr': {
                'class': 'form-control',
                'placeholder': 'Type your message here...'
            }
        }) }}

        {{ form_widget(form.mediaFile, {
