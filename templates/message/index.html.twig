{% extends 'base.html.twig' %}

{% block title %}Message index{% endblock %}

{% block body %}
<div class="container-fluid vh-100 p-0">
    <div class="row g-0 h-100">
         <!-- Channels Sidebar -->
        <div class="col-md-4 h-100 d-flex flex-column border-end">
            {% include 'message/_channel_list.html.twig' %}
        </div>

        <!-- Messages Content -->
        <div class="col-md-8 d-flex flex-column h-100">
            <div class="p-3 border-bottom">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Messages</h5>
                    <small class="text-muted">{{ messages|length }} messages</small>
                </div>
            </div>

            <!-- Scrollable messages area -->
            <div class="flex-grow-1 overflow-auto p-3 bg-grey">
                <div class="chat-content">
                    {% for message in messages %}
                        {% if editForm is defined and editForm.vars.value.idMessage == message.idMessage %}
                            <!-- Edit Form -->
                            <div class="chat {% if loop.index % 2 == 0 %}chat-left{% endif %}">
                                <div class="chat-body">
                                    <div class="chat-message">
                                        {{ form_start(editForm, {'attr': {'class': 'edit-message-form'}}) }}
                                        <div class="mb-3">
                                            {{ form_widget(editForm.content, {'attr': {
                                                'class': 'form-control',
                                                'rows': 3
                                            }}) }}
                                        </div>
                                        {% if message.media %}
                                            <div class="mb-3">
                                                <img src="{{ asset('uploads/' ~ message.media) }}" alt="Current Media" class="img-thumbnail" style="max-width: 200px;">
                                            </div>
                                        {% endif %}
                                        <div class="mb-3">
                                            {{ form_label(editForm.media, 'Change Media:') }}
                                            {{ form_widget(editForm.media) }}
                                        </div>
                                        <div class="d-flex justify-content-end gap-2">
                                            <button type="submit" class="btn btn-primary btn-sm">Update</button>
                                            <a href="{{ path('app_message_index') }}" class="btn btn-secondary btn-sm">Cancel</a>
                                        </div>
                                        {{ form_widget(editForm.channel, {'attr': {'class': 'd-none'}}) }}
                                        {{ form_widget(editForm.sender, {'attr': {'class': 'd-none'}}) }}
                                        {{ form_end(editForm) }}
                                    </div>
                                </div>
                            </div>
                        {% else %}
                            <!-- Message Display -->
                            <div class="chat {% if loop.index % 2 == 0 %}chat-left{% endif %}">
                                <div class="chat-body">
                                    <div class="chat-message" onclick="this.querySelector('.message-time-full').classList.toggle('d-none')">
                                        <div class="message-content">
                                            {{ message.content }}
                                            {% if message.media %}
                                                <div class="message-media mt-2">
                                                    <img src="{{ asset('uploads/' ~ message.media) }}" alt="Media" class="img-thumbnail" style="max-width: 200px;">
                                                </div>
                                            {% endif %}
                                        </div>
                                        <div class="message-meta d-flex justify-content-between align-items-center mt-2">
                                            <small class="message-time text-muted">
                                                {{ message.getTimeSent() ? message.getTimeSent()|date('H:i') : '' }}
                                            </small>
                                            <small class="message-time-full d-none">
                                                {{ message.getTimeSent() ? message.getTimeSent()|date('Y-m-d H:i:s') : '' }}
                                            </small>
                                            <div class="message-actions">
                                                <a href="{{ path('app_message_edit_inline', {'id_message': message.idMessage}) }}" class="text-primary me-2">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <form method="post" action="{{ path('app_message_delete', {'id_message': message.idMessage}) }}" style="display: inline;" onsubmit="return confirm('Are you sure?')">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ message.idMessage) }}">
                                                    <button type="submit" class="text-danger bg-transparent border-0 p-0">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                    {% else %}
                        <div class="text-center py-5 text-muted">
                            No messages found
                        </div>
                    {% endfor %}
                </div>
            </div>

            <!-- New Message Form -->
            <div class="p-3 border-top bg-white" style="position: sticky; bottom: 0;">
                {{ form_start(form, {'attr': {'class': 'd-flex'}}) }}
                
                {# Let Symfony handle channel and sender #}
                {{ form_widget(form.channel, {'attr': {'class': 'd-none'}}) }}
                {{ form_widget(form.sender, {'attr': {'class': 'd-none'}}) }}
                
                <div class="input-group">
                    {{ form_widget(form.content, {'attr': {
                        'class': 'form-control',
                        'placeholder': 'Type your message...'
                    }}) }}
                    
                    <label class="input-group-text" style="cursor: pointer;" for="{{ form.media.vars.id }}">
                        <i class="bi bi-paperclip"></i>
                    </label>
                    
                    {{ form_widget(form.media, {'attr': {'class': 'd-none'}}) }}
                    
                    <button type="submit" class="btn btn-primary">Send</button>
                </div>
                
                {{ form_end(form) }}
            </div>

        </div>
    </div>
</div>
{% endblock %}

{% block styles %}
<style>
    body {
        overflow: hidden;
    }
    .bg-grey {
        background-color: #f5f5f5;
    }
    .chat {
        border-radius: 5px;
    }
    .chat.chat-left .chat-message {
        background: #5a8dee;
        float: left;
        color: #fff;
    }
    .chat .chat-message {
        text-align: left;
        float: right;
        margin: 0.2rem 0 1.8rem 0.2rem;
        color: #525361;
        background-color: #fafbfb;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
        padding: 0.75rem 1rem;
        position: relative;
        max-width: calc(100% - 5rem);
        clear: both;
        word-break: break-word;
        border-radius: 0.267rem;
        cursor: pointer;
    }
    .chat.chat-left .message-time,
    .chat.chat-left .message-actions a,
    .chat.chat-left .message-actions button {
        color: rgba(255, 255, 255, 0.7) !important;
    }
    .message-actions {
        opacity: 0;
        transition: opacity 0.2s;
    }
    .chat-message:hover .message-actions {
        opacity: 1;
    }
    .message-time-full {
        position: absolute;
        bottom: -1.5rem;
        left: 0;
        background: rgba(0, 0, 0, 0.7);
        color: white;
        padding: 0.2rem 0.5rem;
        border-radius: 0.25rem;
        z-index: 10;
    }
    .chat-left .message-time-full {
        left: auto;
        right: 0;
    }
    .list-group-item {
        border-left: 0;
        border-right: 0;
        padding: 0.75rem 1.25rem;
    }
    .edit-message-form {
        padding: 1rem;
        background: #f8f9fa;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
    }
    #user-select {
    cursor: pointer;
}

.list-group-item.active {
    background-color: #5a8dee;
    border-color: #5a8dee;
}

.list-group-item-action:hover {
    background-color: #f5f5f5;
}
</style>
{% endblock %}