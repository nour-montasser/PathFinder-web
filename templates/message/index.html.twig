{% extends 'base.html.twig' %}

{% block title %}Message index
{% endblock %}

{% block body %}
	<div class="container-fluid vh-100 p-0">
		<div
			class="row g-0 h-100">
			<!-- Channels Sidebar -->
			<div class="col-md-4 h-100 d-flex flex-column border-end">
				{% include 'message/_channel_list.html.twig' %}
			</div>

			<!-- Messages Content -->
			<div class="col-md-8 d-flex flex-column h-100 position-relative">
    <div class="p-3 border-bottom">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Messages</h5>
            <small class="text-muted">{{ messages|length }} messages</small>
        </div>
    </div>

				<!-- Scrollable messages area -->
				<div id="messages-container" class="flex-grow-1 overflow-auto p-3 bg-grey">
					<div class="chat-content">
						{% for message in messages %}
							<div class="d-flex {% if message.sender.getId_user == currentUser.getId_user %}justify-content-end{% else %}justify-content-start{% endif %} mb-3">
								{% if message.sender.getId_user != currentUser.getId_user %}
									<!-- Profile picture for received messages -->
									<div class="me-3">
										{% if message.sender.image %}
											<img src="{{ message.sender.image }}" alt="{{ message.sender.name }}" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;">
										{% else %}
											<img src="{{ asset('build/images/faces/default-profile.png') }}" alt="Default profile" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;">
										{% endif %}
									</div>
								{% endif %}

								<div class="chat-message {% if message.sender.getId_user == currentUser.getId_user %}sent-message{% else %}received-message{% endif %}">
									{% if editingMessageId is defined and editingMessageId == message.idMessage %}
										<div class="edit-message-form mb-3">
											{{ form_start(editForm, {'attr': {'class': 'd-flex'}}) }}
											{{ form_widget(editForm.content, {'attr': {
                        'class': 'form-control',
                        'placeholder': 'Edit your message...'
                    }}) }}
											<button type="submit" class="btn btn-primary ms-2">Update</button>
											{{ form_end(editForm) }}
										</div>
									{% else %}
										<div class="message-content">
											{{ message.content }}
											{% if message.media %}
												<div class="message-media mt-2">
													{% if message.media %}
														{% set filePath = 'uploads/' ~ message.media %}
														{% if message.media matches '/\.(jpe?g|png|gif)$/i' %}
															<img src="{{ asset(filePath) }}" style="max-width: 200px;">
														{% else %}
															<a href="{{ asset(filePath) }}" download>Download file</a>
														{% endif %}
													{% endif %}
												</div>
											{% endif %}
										</div>
										<div class="message-meta d-flex justify-content-between align-items-center mt-1">
											<small class="message-time">
												{{ message.timeSent ? message.timeSent|date('H:i') : '' }}
											</small>
											{% if message.sender.getId_user == currentUser.getId_user %}
												<div class="message-actions">
													<a href="{{ path('app_message_edit_inline', {'id_message': message.idMessage}) }}" class="text-white ms-2">
														<i class="bi bi-pencil"></i>
													</a>
													<form method="post" action="{{ path('app_message_delete', {'id_message': message.idMessage}) }}" class="d-inline" onsubmit="return confirm('Are you sure?')">
														<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ message.idMessage) }}">
														<button type="submit" class="text-white bg-transparent border-0 p-0 ms-1">
															<i class="bi bi-trash"></i>
														</button>
													</form>
												</div>
											{% endif %}
										</div>
									{% endif %}
								</div>

								{% if message.sender.getId_user == currentUser.getId_user %}
									<!-- Profile picture for sent messages (optional) -->
									<div class="ms-3">
										{% if currentUser.image %}
											<img src="{{ currentUser.image }}" alt="{{ currentUser.name }}" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;">
										{% else %}
											<img src="{{ asset('build/images/faces/default-profile.png') }}" alt="Default profile" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;">
										{% endif %}
									</div>
								{% endif %}
							</div>
						{% endfor %}
						<div id="scroll-anchor"></div>


					</div>
				</div>

				<!-- New Message Form -->
				<!-- New Message Form -->
<div class="border-top bg-white">
    {{ form_start(form) }}
    <div class="input-group">
        {{ form_widget(form.content, {
            'attr': {
                'class': 'form-control',
                'placeholder': 'Type your message here...'
            }
        }) }}

        {{ form_widget(form.mediaFile, {
            'attr': {
                'class': 'd-none'
            },
            'label': false
        }) }}

        <label class="input-group-text" for="{{ form.mediaFile.vars.id }}" title="Attach file">
            <i class="bi bi-paperclip"></i>
        </label>

        <button type="submit" class="btn btn-primary">
            <i class="bi bi-send"></i>
        </button>
    </div>
    {{ form_end(form) }}
</div>
				

			</div>
		</div>
	</div>
	<script>
function scrollToBottom(force = false) {
    const container = document.getElementById('messages-container');
    if (!container) return;

    // Add a small delay to ensure content is rendered
    setTimeout(() => {
        const scrollHeight = container.scrollHeight;
        const scrollTop = container.scrollTop;
        const clientHeight = container.clientHeight;
        const inputHeight = 70; // Match the height from CSS
        
        // Calculate if we're near the bottom (within 100px)
        const isAtBottom = (scrollHeight - scrollTop - inputHeight) <= (clientHeight + 100);

        if (force || isAtBottom) {
            // Scroll to bottom while accounting for the input area
            container.scrollTop = scrollHeight - clientHeight + inputHeight;
        }
    }, 100); // Increased delay for better reliability
}

// Scroll on page load
document.addEventListener('DOMContentLoaded', () =>scrollToBottom(true)
);
document.addEventListener('turbo:render', () => scrollToBottom(true));
window.addEventListener('load', () => scrollToBottom(true));
const messagesContainer = document.getElementById('messages-container');
if (messagesContainer) {
    const observer = new MutationObserver(() => scrollToBottom(true));
    observer.observe(messagesContainer, { 
        childList: true, 
        subtree: true 
    });
}
	</script>

{# Define user variables first #}
<script>
    // These variables must be defined BEFORE websocket.js loads
    const currentUserId = {{ currentUser.getId_user() }};
    const channelId = {{ selectedChannelId ?? 'null' }};
    const currentUserImage = "{{ currentUser.image ? currentUser.image : asset('build/images/faces/default-profile.png') }}";
    const currentUserName = "{{ currentUser.name }}";
</script>

{# Define user variables in a hidden element #}
<div id="current-user-data" 
     data-user-id="{{ currentUser.getId_user() }}"
     data-channel-id="{{ selectedChannelId ?? '' }}"
     data-user-image="{{ currentUser.image ? currentUser.image : asset('build/images/faces/default-profile.png') }}"
     style="display:none;"></div>

{# Single script section #}
<script>
// WebSocketClient class definition
class WebSocketClient {
    constructor(userId, channelId, userImage) {
        this.userId = userId;
        this.channelId = channelId;
        this.userImage = userImage || '/build/images/faces/default-profile.png';
        this.socket = null;
        this.messageQueue = [];
        this.connectAttempts = 0;
        this.maxConnectAttempts = 5;
        this.connect();
        
        // Keepalive ping every 25 seconds
        this.keepaliveInterval = setInterval(() => {
            if (this.socket?.readyState === WebSocket.OPEN) {
                this.socket.send(JSON.stringify({ type: 'ping' }));
            }
        }, 25000);
    }

    connect() {
        this.connectAttempts++;
        if (this.connectAttempts > this.maxConnectAttempts) {
            console.error('Max connection attempts reached');
            return;
        }

        this.socket = new WebSocket(`ws://${window.location.hostname}:8082`);

        this.socket.onopen = () => {
            console.log('WebSocket connected');
            this.connectAttempts = 0;
            this.authenticate();
            this.subscribe();
            this.flushMessageQueue();
        };

        this.socket.onmessage = (event) => {
            try {
                const data = JSON.parse(event.data);
                this.handleMessage(data);
            } catch (e) {
                console.error('Message parse error:', e);
            }
        };

        this.socket.onclose = () => {
            console.log('WebSocket disconnected, reconnecting...');
            setTimeout(() => this.connect(), 3000);
        };

        this.socket.onerror = (error) => {
            console.error('WebSocket error:', error);
        };
    }

    authenticate() {
        if (this.socket?.readyState === WebSocket.OPEN) {
            this.socket.send(JSON.stringify({
                type: 'auth',
                userId: this.userId
            }));
        }
    }

    subscribe() {
        if (this.socket?.readyState === WebSocket.OPEN) {
            this.socket.send(JSON.stringify({
                type: 'subscribe',
                channelId: this.channelId,
                userId: this.userId
            }));
        }
    }

    sendMessage(content) {
        if (!content || !content.trim()) return;

        const message = {
            type: 'message',
            content: content.trim(),
            channelId: this.channelId,
            userId: this.userId
        };

        if (this.socket?.readyState === WebSocket.OPEN) {
            this.socket.send(JSON.stringify(message));
        } else {
            // Queue message if connection isn't ready
            this.messageQueue.push(message);
            console.log('Message queued, connection not ready');
        }
    }

    flushMessageQueue() {
        while (this.messageQueue.length > 0 && this.socket?.readyState === WebSocket.OPEN) {
            const message = this.messageQueue.shift();
            this.socket.send(JSON.stringify(message));
        }
    }

    handleMessage(data) {
        switch (data.type) {
            case 'message':
                this.displayMessage(data);
                break;
            case 'error':
                console.error('Server error:', data.message);
                break;
            case 'authenticated':
                console.log('Successfully authenticated');
                break;
            case 'subscribed':
                console.log('Successfully subscribed to channel');
                break;
            case 'pong':
                // Keepalive response
                break;
            default:
                console.warn('Unknown message type:', data.type);
        }
    }

    displayMessage(message) {
        const messagesContainer = document.getElementById('messages-container');
        if (!messagesContainer) {
            console.error('Messages container not found');
            return;
        }

        const isCurrentUser = message.sender?.id === this.userId;
    const messageDiv = document.createElement('div');
    messageDiv.className = `d-flex ${isCurrentUser ? 'justify-content-end' : 'justify-content-start'} mb-3`
        
        // Use the sender's image from the message or fallback
        const senderImage = message.sender?.image || '/build/images/faces/default-profile.png';
        
        messageDiv.innerHTML = `
            ${!isCurrentUser ? `
                <div class="me-3">
                    <img src="${senderImage}" 
                         class="rounded-circle" style="width:40px;height:40px;object-fit:cover;">
                </div>
            ` : ''}
            
            <div class="chat-message ${isCurrentUser ? 'sent-message' : 'received-message'}">
                <div class="message-content">${message.content}</div>
                <div class="message-meta d-flex justify-content-between mt-1">
                    <small class="message-time">${message.timeSent}</small>
                </div>
            </div>
            
            ${isCurrentUser ? `
                <div class="ms-3">
                    <img src="${this.userImage}" 
                         class="rounded-circle" style="width:40px;height:40px;object-fit:cover;">
                </div>
            ` : ''}
        `;
        
         messagesContainer.appendChild(messageDiv);
   		 setTimeout(() => {
        scrollToBottom(true);
    }, 50);
    }

    scrollToBottom() {
    window.scrollToBottom(true); // Use the global function
}

    disconnect() {
        if (this.socket) {
            clearInterval(this.keepaliveInterval);
            this.socket.close();
        }
    }
}

// Initialize when page loads
document.addEventListener('DOMContentLoaded', () => {
    const userData = document.getElementById('current-user-data');
    if (!userData) {
        console.error('Current user data element not found');
        return;
    }

    const currentUserId = parseInt(userData.dataset.userId);
    const channelId = userData.dataset.channelId ? parseInt(userData.dataset.channelId) : null;
    const currentUserImage = userData.dataset.userImage;

    if (channelId && !isNaN(currentUserId)) {
        window.wsClient = new WebSocketClient(currentUserId, channelId, currentUserImage);

        const messageForm = document.querySelector('form[name="message"]');
        if (messageForm) {
            messageForm.addEventListener('submit', (e) => {
                e.preventDefault();
                const input = messageForm.querySelector('input[name="message[content]"]');
                const textarea = messageForm.querySelector('textarea[name="message[content]"]');
                const messageInput = input || textarea;
                
                if (messageInput?.value.trim()) {
                    window.wsClient.sendMessage(messageInput.value.trim());
                    messageInput.value = '';
                    
                    // Also submit the form normally for fallback
                    if (window.wsClient.socket?.readyState !== WebSocket.OPEN) {
                        messageForm.submit();
                    }
                }
            });
        }
    } else {
        console.error('Missing required user data or channel ID');
    }
});
</script>
{% endblock %}


