                'class': 'd-none'
            },
            'label': false
        }) }}

        <label class="input-group-text" for="{{ form.mediaFile.vars.id }}" title="Attach file">
            <i class="bi bi-paperclip"></i>
        </label>

        <button type="submit" class="btn btn-primary">
            <i class="bi bi-send"></i>
        </button>
    </div>
    {{ form_end(form) }}
</div>
				

