{% extends 'base.html.twig' %}

{% block title %}Message index
{% endblock %}

{% block body %}
	<div class="container-fluid vh-100 p-0">
		<div
			class="row g-0 h-100">
			<!-- Channels Sidebar -->
			<div class="col-md-4 h-100 d-flex flex-column border-end">
				{% include 'message/_channel_list.html.twig' %}
			</div>

			<!-- Messages Content -->
			<div class="col-md-8 d-flex flex-column h-100">
				<div class="p-3 border-bottom">
					<div class="d-flex justify-content-between align-items-center">
						<h5 class="mb-0">Messages</h5>
						<small class="text-muted">{{ messages|length }}
							messages</small>
					</div>
				</div>

				<!-- Scrollable messages area -->
				<div id="messages-container" class="flex-grow-1 overflow-auto p-3 bg-grey">
					<div class="chat-content">
						{% for message in messages %}
							<div class="d-flex {% if message.sender.getId_user == currentUser.getId_user %}justify-content-end{% else %}justify-content-start{% endif %} mb-3">
								{% if message.sender.getId_user != currentUser.getId_user %}
									<!-- Profile picture for received messages -->
									<div class="me-3">
										{% if message.sender.image %}
											<img src="{{ message.sender.image }}" alt="{{ message.sender.name }}" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;">
										{% else %}
											<img src="{{ asset('build/images/faces/default-profile.png') }}" alt="Default profile" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;">
										{% endif %}
									</div>
								{% endif %}

								<div class="chat-message {% if message.sender.getId_user == currentUser.getId_user %}sent-message{% else %}received-message{% endif %}">
									{% if editingMessageId is defined and editingMessageId == message.idMessage %}
										<div class="edit-message-form mb-3">
											{{ form_start(editForm, {'attr': {'class': 'd-flex'}}) }}
											{{ form_widget(editForm.content, {'attr': {
                        'class': 'form-control',
                        'placeholder': 'Edit your message...'
                    }}) }}
											<button type="submit" class="btn btn-primary ms-2">Update</button>
											{{ form_end(editForm) }}
										</div>
									{% else %}
										<div class="message-content">
											{{ message.content }}
											{% if message.media %}
												<div class="message-media mt-2">
													{% if message.media %}
														{% set filePath = 'uploads/' ~ message.media %}
														{% if message.media matches '/\.(jpe?g|png|gif)$/i' %}
															<img src="{{ asset(filePath) }}" style="max-width: 200px;">
														{% else %}
															<a href="{{ asset(filePath) }}" download>Download file</a>
														{% endif %}
													{% endif %}
												</div>
											{% endif %}
										</div>
										<div class="message-meta d-flex justify-content-between align-items-center mt-1">
											<small class="message-time">
												{{ message.timeSent ? message.timeSent|date('H:i') : '' }}
											</small>
											{% if message.sender.getId_user == currentUser.getId_user %}
												<div class="message-actions">
													<a href="{{ path('app_message_edit_inline', {'id_message': message.idMessage}) }}" class="text-white ms-2">
														<i class="bi bi-pencil"></i>
													</a>
													<form method="post" action="{{ path('app_message_delete', {'id_message': message.idMessage}) }}" class="d-inline" onsubmit="return confirm('Are you sure?')">
														<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ message.idMessage) }}">
														<button type="submit" class="text-white bg-transparent border-0 p-0 ms-1">
															<i class="bi bi-trash"></i>
														</button>
													</form>
												</div>
											{% endif %}
										</div>
									{% endif %}
								</div>

								{% if message.sender.getId_user == currentUser.getId_user %}
									<!-- Profile picture for sent messages (optional) -->
									<div class="ms-3">
										{% if currentUser.image %}
											<img src="{{ currentUser.image }}" alt="{{ currentUser.name }}" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;">
										{% else %}
											<img src="{{ asset('build/images/faces/default-profile.png') }}" alt="Default profile" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;">
										{% endif %}
									</div>
								{% endif %}
							</div>
						{% endfor %}
						<div id="scroll-anchor"></div>


					</div>
				</div>

				<!-- New Message Form -->
<div class="p-3 border-top bg-white" style="position: sticky; bottom: 0;">
    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
    <div class="input-group mb-3">
        {{ form_widget(form.content, {
            'attr': {
                'class': 'form-control',
                'placeholder': 'Type your message here...'
            }
        }) }}
			{# ✅ Display errors below the input #}
	{% if form.content.vars.errors|length > 0 %}
		<div class="invalid-feedback d-block">
			{{ form_errors(form.content) }}
		</div>
	{% endif %}

        {{ form_widget(form.mediaFile, {
            'attr': {
                'class': 'd-none'
            },
            'label': false
        }) }}

  <label class="input-group-text" for="{{ form.mediaFile.vars.id }}" title="Attach file">
    <i class="bi bi-paperclip"></i>
</label>

{% if form.mediaFile.vars.errors|length > 0 %}
    <div class="invalid-feedback d-block">
        {{ form_errors(form.mediaFile) }}
    </div>
{% endif %}


        <button type="submit" class="btn btn-primary">
            <i class="bi bi-send"></i>
        </button>
    </div>
    {{ form_end(form) }}
</div>


			</div>
		</div>
	</div>
	<script>
		function scrollToBottom(force = false) {
const container = document.getElementById('messages-container');
if (! container) 
return;



const isAtBottom = container.scrollHeight - container.scrollTop<= container.clientHeight + 100;

	if (force || isAtBottom) {
		container.scrollTop = container.scrollHeight;
	}
}

// Scroll on page load
document.addEventListener('DOMContentLoaded', () =>scrollToBottom(true)
);
document.addEventListener('turbo:render', () => scrollToBottom(true));
window.addEventListener('load', () => scrollToBottom(true));
	</script>


{% endblock %}


{% block styles %}
	<style>
		body {
			overflow: hidden; /* ✅ Keep this */
		}


		html,
		body {
			height: 100%;
		}
		.bg-grey {
			background-color: #f5f5f5;
		}
		.chat {
			border-radius: 5px;
		}
		.chat.chat-left .chat-message {
			background: #5a8dee;
			float: left;
			color: #fff;
		}
		.chat .chat-message {
			text-align: left;
			float: right;
			margin: 0.2rem 0 1.8rem 0.2rem;
			color: #525361;
			background-color: #fafbfb;
			box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
			padding: 0.75rem 1rem;
			position: relative;
			max-width: calc(100% - 5rem);
			clear: both;
			word-break: break-word;
			border-radius: 0.267rem;
			cursor: pointer;
		}
		.chat.chat-left .message-time,
		.chat.chat-left .message-actions a,
		.chat.chat-left .message-actions button {
			color: rgba(255, 255, 255, 0.7) !important;
		}
		.message-actions {
			opacity: 0;
			transition: opacity 0.2s;
		}
		.chat-message:hover .message-actions {
			opacity: 1;
		}
		.message-time-full {
			position: absolute;
			bottom: -1.5rem;
			left: 0;
			background: rgba(0, 0, 0, 0.7);
			color: white;
			padding: 0.2rem 0.5rem;
			border-radius: 0.25rem;
			z-index: 10;
		}
		.chat-left .message-time-full {
			left: auto;
			right: 0;
		}
		.list-group-item {
			border-left: 0;
			border-right: 0;
			padding: 0.75rem 1.25rem;
		}
		.edit-message-form {
			background: #f8f9fa;
			box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
		}
		#user-select {
			cursor: pointer;
		}

	
		.list-group-item-action:hover {
			background-color: #f5f5f5;
		}
		/* Add to your existing styles */
		.list-group-item {
			display: flex;
			align-items: center;
			padding: 0.75rem 1.25rem;
		}

		.list-group-item a {
			flex-grow: 1;
		}

		.btn-danger {
			opacity: 0;
			transition: opacity 0.2s;
		}

		.list-group-item:hover .btn-danger {
			opacity: 1;
		}

		/* Message bubbles */
		.chat-left .chat-message {
			background: #f1f1f1; /* Grey for received messages */
			color: #333;
			float: left;
			margin-right: auto;
		}

		.chat-right .chat-message {
			background: #5a8dee; /* Blue for sent messages */
			color: white;
			float: right;
			margin-left: auto;
		}

		/* Consistent message bubble styling */
		.chat-message {
			max-width: 70%;
			padding: 0.75rem 1rem;
			border-radius: 0.75rem;
			margin-bottom: 0.5rem;
			position: relative;
			clear: both;
		}

		/* Message bubbles */
		.chat-message {
			max-width: 70%;
			padding: 0.75rem 1rem;
			border-radius: 1rem;
			position: relative;
			word-wrap: break-word;
		}

		.sent-message {
			background: #5a8dee; /* Blue for sent messages */
			color: white;
			border-bottom-right-radius: 0;
		}

		.received-message {
			background: #f1f1f1; /* Grey for received messages */
			color: #333;
			border-bottom-left-radius: 0;
		}

		/* Message meta information */
		.message-meta {
			font-size: 0.75rem;
		}

		.sent-message .message-time {
			color: rgba(255, 255, 255, 0.7);
		}

		.received-message .message-time {
			color: rgba(0, 0, 0, 0.5);
		}

		/* Action buttons */
		.message-actions {
			opacity: 0;
			transition: opacity 0.2s;
		}

		.chat-message:hover .message-actions {
			opacity: 1;
		}
		.message-media {
			margin-top: 8px;
			padding: 8px;
			background: rgba(0, 0, 0, 0.03);
			border-radius: 4px;
			border: 1px solid rgba(0, 0, 0, 0.1);
		}

		.message-media img {
			max-height: 200px;
			display: block;
		}

		/* For the attachment button */
		.input-group-text {
			cursor: pointer;
			transition: background-color 0.2s;
		}

		.input-group-text:hover {
			background-color: #e9ecef;
		}
		#messages-container {
			overflow-y: auto;
			scroll-behavior: smooth;
			-webkit-overflow-scrolling: touch;
			height: calc(100vh - 200px);
			padding-bottom: 200px;
		}
		.chat-content {
			min-height: min-content;
		}
		.bg-white {
			box-shadow: 0 -2px 5px rgba(0, 0, 0, 0.1);
		}
		.chat-content > div:last-child {
			margin-bottom: 160px; /* Creates space above the input box */
		}
	</style>
{% endblock %}
