{% extends 'base.html.twig' %}

{% block title %}Password Reset Success{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body text-center">
                    <h2 class="card-title mb-4">Password Reset Successful</h2>
                    <p class="card-text">A new password has been sent to your email address: {{ email }}</p>
                    
                    <div class="alert alert-info" role="alert">
                        <i class="fas fa-info-circle"></i>
                        You'll find a QR code containing your password in the email.
                    </div>

                    <div class="mt-4">
                        <a href="{{ path('app_login') }}" class="btn btn-outline-secondary">
                            <i class="fas fa-sign-in-alt me-2"></i>Return to Login
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %} 