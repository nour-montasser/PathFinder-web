{% extends 'base.html.twig' %}

{% block title %}Login{% endblock %}

{% block body %}
<div class="login-container" style="max-width: 400px; margin: 80px auto; padding: 2rem; box-shadow: 0 0 10px rgba(0,0,0,0.1); border-radius: 10px;">
    <h2 style="text-align: center;">Login</h2>

    {% if error %}
        <div style="color: red; margin-bottom: 1rem; text-align: center;">
            {{ error }}
        </div>
    {% endif %}

  {{ form_start(form, {
    'attr': {
        'class': 'mt-4',
        'novalidate': 'novalidate'
    }
}) }}

    
    <div class="form-group position-relative has-icon-left mb-4">
        <div class="form-control-icon">
            <i class="bi bi-envelope text-primary"></i>
        </div>
        {{ form_widget(form.email) }}
        {{ form_errors(form.email) }}
    </div>
    
    <div class="form-group position-relative has-icon-left mb-4">
        <div class="form-control-icon">
            <i class="bi bi-shield-lock text-primary"></i>
        </div>
        {{ form_widget(form.password) }}
        {{ form_errors(form.password) }}
    </div>
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="form-check">
   
        </div>
        
        <p class="mt-3">
            <a class="font-bold text-primary" href="{{ path('app_forgot_password') }}">
                <i class="bi bi-key me-1"></i> Forgot password?
            </a>
        </p>
    </div>
    
    <button type="submit" class="btn btn-primary btn-block btn-lg shadow-lg">
        <i class="bi bi-box-arrow-in-right me-2"></i> Login
    </button>
    {{ form_end(form) }}

    <div class="text-center mt-5">
        <p class="text-muted">New to our platform?</p>
        <a href="{{ path('app_register') }}" class="btn btn-outline-primary btn-lg">
            <i class="bi bi-person-plus me-2"></i> Create Account
        </a>
    </div>
</div>
{% endblock %}