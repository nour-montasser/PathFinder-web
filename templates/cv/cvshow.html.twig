{% extends 'base.html.twig' %}

{% block title %}My CVs
{% endblock %}
{% block style %}
	<style>
		#cv-filter {
			min-width: 160px;
		}
	</style>
{% endblock %}
{% block body %}
	<!-- Full-width background bar -->
	<div class="bg-white shadow-sm py-3 px-4 mb-4 w-100">
		<div class="container-fluid">
			<div
				class="row align-items-center justify-content-between">

				<!-- Left: Title -->
				<div class="col-md-3 d-flex align-items-center">
					<h2 class="mb-0">My CVs</h2>
				</div>

				<!-- Center: Search Bar -->
				<div class="col-md-5 my-2 my-md-0">
					<input type="text" id="cv-search" class="form-control rounded-pill" placeholder="Search CVs...">
				</div>

				<!-- Right: Create button + Select filter -->
				<div class="col-md-4 d-flex justify-content-end align-items-center gap-2">
					<a href="{{ path('app_cv') }}" class="btn btn-primary">Create a CV</a>

					<select id="cv-filter" class="form-select w-auto rounded">
						<option value="all">All</option>
						<option value="favorites">Favorites</option>
						<option value="recent">Recently Viewed</option>
					</select>
				</div>

			</div>
		</div>
	</div>

	<div class="row justify-content-start g-0">
    {% for cv in cvs %}
       <div class="col-md-4 d-flex justify-content-center">
    <div class="card shadow-sm mb-4 position-relative" style="aspect-ratio: 1 / 1.41; max-width: 320px; width: 100%;">
        <div class="card-body d-flex flex-column">
            
            <!-- CV Preview Image -->
            <img src="{{ asset('images/previews/cv-' ~ cv.id ~ '.png') }}"
                 alt="CV Preview"
                 class="img-fluid rounded mb-3"
                 style="width: 100%; object-fit: cover;">

            <div class="mb-3">
                <h5 class="card-title">{{ cv.userTitle }}</h5>
                <h6 class="card-subtitle text-muted">{{ cv.title }}</h6>
                <p class="card-text mt-2">Created: {{ cv.dateCreation|date('Y-m-d') }}</p>
            </div>

            <div class="mt-auto d-flex justify-content-between">
                <a href="{{ path('cv_edit', { 'id': cv.id }) }}" class="btn btn-sm btn-outline-primary">Edit</a>
                <form method="post" action="{{ path('cv_delete', { 'id': cv.id }) }}" onsubmit="return confirm('Are you sure you want to delete this CV?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ cv.id) }}">
                    <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

    {% else %}
        <div class="col-12 text-center">
            <p>No CV found.</p>
        </div>
    {% endfor %}
</div>
</div></div>{% endblock %}
