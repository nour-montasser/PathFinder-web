{% extends 'base.html.twig' %}

{% block title %}Feedback List{% endblock %}

{% block body %}
    <h1 class="mb-4">Feedbacks Received</h1>

    {# Add search input #}
    <div class="mb-3">
        <input type="text" id="searchFeedback" class="form-control" placeholder="Search feedbacks...">
    </div>

    <div id="feedbackTableContainer">
        {% if feedbacks %}
            <table class="table table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Subject</th>
                        <th>Message</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="feedbackTableBody">
                    {% for feedback in feedbacks %}
                        <tr>
                            <td>{{ feedback.id }}</td>
                            <td>{{ feedback.name }}</td>
                            <td>{{ feedback.subject }}</td>
                            <td>{{ feedback.message }}</td>
                            <td>
                                <button class="btn btn-sm btn-danger" 
                                    onclick="if(confirm('Delete this feedback?')) { 
                                        document.getElementById('delete-feedback-{{ feedback.id }}').submit(); 
                                    }">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <div class="alert alert-info">No feedbacks available.</div>
        {% endif %}
    </div>

    {# Add JavaScript for AJAX search #}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('searchFeedback');
            let typingTimer;
            const doneTypingInterval = 300; // milliseconds

            searchInput.addEventListener('input', function() {
                clearTimeout(typingTimer);
                typingTimer = setTimeout(performSearch, doneTypingInterval);
            });

            function performSearch() {
                const searchTerm = searchInput.value;
                
                fetch(`{{ path('admin_feedback_search') }}?q=${encodeURIComponent(searchTerm)}`)
                    .then(response => response.json())
                    .then(data => {
                        const tbody = document.getElementById('feedbackTableBody');
                        tbody.innerHTML = '';

                        data.forEach(feedback => {
                            const tr = document.createElement('tr');
                            tr.innerHTML = `
                                <td>${feedback.id}</td>
                                <td>${feedback.name}</td>
                                <td>${feedback.subject}</td>
                                <td>${feedback.message}</td>
                                <td>
                                    <button class="btn btn-sm btn-danger" 
                                        onclick="if(confirm('Delete this feedback?')) { 
                                            document.getElementById('delete-feedback-${feedback.id}').submit(); 
                                        }">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            `;
                            tbody.appendChild(tr);
                        });
                    })
                    .catch(error => console.error('Error:', error));
            }
        });
    </script>
{% endblock %}
