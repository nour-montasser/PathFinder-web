{% extends 'admin/base.html.twig' %}

{% block title %}User Details{% endblock %}

{% block body %}
<div class="welcome-banner">
    <h4 class="mb-0">User Management</h4>
</div>

<div class="page-title">
    <h1>User Details</h1>
    <a href="{{ path('admin_users') }}" class="btn-outline-panel">
        <i class="bi bi-arrow-left"></i> Back to Users
    </a>
</div>

<div class="card">
    <div class="card-header">
        <h5 class="m-0">{{ user.name }}</h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-4 mb-3">
                <div class="card h-100">
                    <div class="card-body text-center">
                        {% if user.image and user.image != 'default.png' %}
                            <img src="{{ asset('uploads/users/' ~ user.image) }}" alt="{{ user.name }}" 
                                 class="rounded-circle mb-3" style="width: 150px; height: 150px; object-fit: cover;">
                        {% else %}
                            <div class="user-avatar-placeholder mb-3 mx-auto" 
                                 style="width: 150px; height: 150px; background-color: #f5f5f5; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                <i class="bi bi-person" style="font-size: 4rem; color: #aaa;"></i>
                            </div>
                        {% endif %}
                        <h5>{{ user.name }}</h5>
                        <p class="text-muted">
                            {% if user.role == 2 %}
                                <span class="badge" style="background-color: #8B4513;">Job Seeker</span>
                            {% elseif user.role == 1 %}
                                <span class="badge bg-success">Enterprise</span>
                            {% elseif user.role == 3 %}
                                <span class="badge bg-danger">Admin</span>
                            {% endif %}
                        </p>
                    </div>
                </div>
            </div>
            
            <div class="col-md-8 mb-3">
                <div class="card h-100">
                    <div class="card-header">
                        <h6 class="m-0">User Information</h6>
                    </div>
                    <div class="card-body">
                        <table class="table table-bordered">
                            <tbody>
                                <tr>
                                    <th style="width: 30%;">ID</th>
                                    <td>{{ user.id_user }}</td>
                                </tr>
                                <tr>
                                    <th>Email</th>
                                    <td>{{ user.email }}</td>
                                </tr>
                                <tr>
                                    <th>Role</th>
                                    <td>
                                        {% if user.role == 2 %}
                                            Job Seeker
                                        {% elseif user.role == 1 %}
                                            Enterprise
                                        {% elseif user.role == 3 %}
                                            Administrator
                                        {% endif %}
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="d-flex justify-content-between mt-3">
            <a href="{{ path('admin_user_edit', {'id': user.id_user}) }}" class="btn btn-warning">
                <i class="bi bi-pencil me-1"></i> Edit User
            </a>
            <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteUserModal">
                <i class="bi bi-trash me-1"></i> Delete User
            </button>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteUserModal" tabindex="-1" aria-labelledby="deleteUserModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteUserModalLabel">Confirm Deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete <strong>{{ user.name }}</strong>? This action cannot be undone.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <a href="{{ path('admin_user_delete', {'id': user.id_user}) }}" class="btn btn-danger">Delete</a>
            </div>
        </div>
    </div>
</div>

{% endblock %} 