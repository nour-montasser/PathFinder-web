<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>PathFinder Users List</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 20px;
        }
        .header {
            text-align: center;
            margin-bottom: 30px;
        }
        .logo {
            max-width: 150px;
        }
        h1 {
            color: #1A1B25;
            font-size: 24px;
            margin: 10px 0;
        }
        .date {
            color: #6e6b7b;
            font-size: 14px;
            margin-bottom: 20px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }
        th {
            background-color: #f2f2f2;
            padding: 10px;
            text-align: left;
            font-weight: bold;
            border-bottom: 1px solid #ddd;
        }
        td {
            padding: 10px;
            border-bottom: 1px solid #ddd;
        }
        .role {
            display: inline-block;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: bold;
            color: #fff;
        }
        .role-1 {
            background-color: #3b82f6; /* Job Seeker */
        }
        .role-2 {
            background-color: #28c76f; /* Enterprise */
        }
        .role-3 {
            background-color: #ea5455; /* Admin */
        }
        .footer {
            margin-top: 30px;
            text-align: center;
            font-size: 12px;
            color: #6e6b7b;
        }
        .page-number {
            position: absolute;
            bottom: 20px;
            right: 20px;
            font-size: 12px;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>PathFinder Admin - Users List</h1>
        <div class="date">Generated on: {{ date|date('F d, Y H:i:s') }}</div>
    </div>
    
    <table>
        <thead>
            <tr>
                <th style="width: 5%;">ID</th>
                <th style="width: 30%;">Name</th>
                <th style="width: 35%;">Email</th>
                <th style="width: 15%;">Role</th>
                <th style="width: 15%;">Registration Date</th>
            </tr>
        </thead>
        <tbody>
            {% for user in users %}
            <tr>
                <td>{{ user.id_user }}</td>
                <td>{{ user.name }}</td>
                <td>{{ user.email }}</td>
                <td>
                    {% if user.role == 1 %}
                        <span class="role role-1">Job Seeker</span>
                    {% elseif user.role == 2 %}
                        <span class="role role-2">Enterprise</span>
                    {% elseif user.role == 3 %}
                        <span class="role role-3">Admin</span>
                    {% endif %}
                </td>
                <td>{% if user.created_at is defined %}{{ user.created_at|date('Y-m-d') }}{% else %}N/A{% endif %}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    
    <div class="footer">
        <p>PathFinder Admin Panel - Confidential Document</p>
    </div>
    
    <div class="page-number">Page 1</div>
</body>
</html> 