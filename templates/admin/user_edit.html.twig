{% extends 'admin/base.html.twig' %}

{% block title %}Edit User{% endblock %}

{% block body %}
<div class="welcome-banner">
    <h4 class="mb-0">User Management</h4>
</div>

<div class="page-title">
    <h1>Edit User</h1>
    <a href="{{ path('admin_users') }}" class="btn-outline-panel">
        <i class="bi bi-arrow-left"></i> Back to Users
    </a>
</div>

<div class="card">
    <div class="card-header">
        <h5 class="m-0">Edit {{ user.name }}</h5>
    </div>
    <div class="card-body">
        <form action="{{ path('admin_user_edit', {'id': user.id_user}) }}" method="post">
            <div class="mb-3">
                <label for="name" class="form-label">Name</label>
                <input type="text" class="form-control" id="name" name="name" value="{{ user.name }}" required>
            </div>
            
            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input type="email" class="form-control" id="email" name="email" value="{{ user.email }}" required>
            </div>
            
            <div class="mb-3">
                <label for="role" class="form-label">Role</label>
                <select class="form-select" id="role" name="role" required>
                    <option value="1" {% if user.role == 1 %}selected{% endif %}>Enterprise</option>
                    <option value="2" {% if user.role == 2 %}selected{% endif %}>Job Seeker</option>
                    <option value="3" {% if user.role == 3 %}selected{% endif %}>Administrator</option>
                </select>
            </div>
            
            <div class="mb-3">
                <label for="password" class="form-label">New Password (leave blank to keep current)</label>
                <input type="password" class="form-control" id="password" name="password">
                <div class="form-text">Minimum 6 characters. Leave empty to keep current password.</div>
            </div>
            
            <div class="d-flex justify-content-between">
                <a href="{{ path('admin_user_view', {'id': user.id_user}) }}" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
        </form>
    </div>
</div>
{% endblock %} 